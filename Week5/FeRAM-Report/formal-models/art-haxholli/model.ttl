ald:Confidence_Level
    a owl:Class ;
    rdfs:label "Confidence Level"@en ;
    owl:equivalentClass
        [
            a owl:Class ;
            owl:oneOf (
                ald:Confidence_High
                ald:Confidence_Medium
                ald:Confidence_Low
                ald:Confidence_Open
            ) ;
        ] ;
    skos:definition "Confidence Level is a concept used in the ALD HfO2 deposition model."@en ;
.

ald:Deposition_Reactor
    a owl:Class ;
    rdfs:label "Deposition Reactor"@en ;
    rdfs:subClassOf ald:Deposition_Equipment ;
    skos:definition "Deposition Reactor is a concept used in the ALD HfO2 deposition model."@en ;
    ald:reportSection "3.8" ;
.

ald:Equipment
    a owl:Class ;
    rdfs:label "Equipment"@en ;
    skos:definition "Equipment is a concept used in the ALD HfO2 deposition model."@en ;
.

ald:Measurement_Result
    a owl:Class ;
    rdfs:label "Measurement Result"@en ;
    rdfs:comment "TBox-only scaffolding in the BS3 build; no measurement or electrical-test individuals are created because the BS3 ledger contains no measurement-result evidence."@en ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onProperty ald:measuredBy ;
            owl:someValuesFrom ald:Characterization_Method ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty ald:assertedBy ;
            owl:someValuesFrom ald:Claim ;
        ] ,
        [
            a owl:Restriction ;
            owl:onClass ald:Measurand ;
            owl:onProperty ald:hasMeasurand ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ] ,
        [
            a owl:Restriction ;
            owl:onClass ald:Specimen ;
            owl:onProperty ald:measuredOn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ] ,
        [
            a owl:Restriction ;
            owl:onClass ald:Quantity_Value ;
            owl:onProperty ald:hasResultValue ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ] ;
    skos:definition "Measurement Result is a concept used in the ALD HfO2 deposition model."@en ;
.

ald:Module_Scope
    a owl:Class ;
    rdfs:label "Module Scope"@en ;
    owl:equivalentClass
        [
            a owl:Class ;
            owl:oneOf (
                ald:Scope_In_Module
                ald:Scope_Out_Of_Module
                ald:Scope_Upstream_Boundary
                ald:Scope_Downstream_Boundary
            ) ;
        ] ;
    skos:definition "Module Scope is a concept used in the ALD HfO2 deposition model."@en ;
.

