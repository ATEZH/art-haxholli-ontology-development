<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/personal-ontology#"
     xml:base="http://www.example.org/personal-ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology>
        <rdfs:comment>Ontology of Art Haxholli</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.example.org/personal-ontology#atOrganization -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#atOrganization">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#hasEmploymentAt"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Employment"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Institution"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#completedProgram -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#completedProgram">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#hasGraduate"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#AcademicProgram"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#contributedTo -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#contributedTo">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#hasContributor"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Project"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#grants -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#grants">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#isGrantedBy"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#University"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Bachelors"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasAcademicProject -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasAcademicProject">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#partOfCourse"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Course"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#AcademicProject"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasBrother -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasBrother">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/personal-ontology#hasSibling"/>
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#isBrotherOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasCity -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasCity">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/personal-ontology#isLocationOf"/>
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#locatedInCountry"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Country"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#City"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasContributor -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasContributor">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Project"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasEmployment -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasEmployment">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#isEmploymentOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Employment"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasEmploymentAt -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasEmploymentAt">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Institution"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Employment"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasFather -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasFather">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/personal-ontology#hasParent"/>
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#isFatherOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasGraduate -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasGraduate">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#AcademicProgram"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasHobby -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasHobby">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#isHobbyOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Activity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasLanguageProficiency -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasLanguageProficiency">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/personal-ontology#hasProficiency"/>
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#isLanguageProficiencyOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#LanguageProficiency"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasMother -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasMother">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/personal-ontology#hasParent"/>
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#isMotherOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasParent -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasParent">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#isParentOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasProficiency -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasProficiency">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#isProficiencyOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasProficiencyRecord -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasProficiencyRecord">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#ofLanguage"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Language"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#LanguageProficiency"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasRole -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasRole">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#isRoleOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Employment"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Role"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasSibling -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasSibling">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasSister -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasSister">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/personal-ontology#hasSibling"/>
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#isSisterOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasSkillProficiency -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasSkillProficiency">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/personal-ontology#hasProficiency"/>
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#isSkillProficiencyOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#SkillProficiency"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#hasSkillProficiencyRecord -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#hasSkillProficiencyRecord">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#ofSkill"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Skill"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#SkillProficiency"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#includesCourse -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#includesCourse">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#isPartOfProgram"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#AcademicProgram"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Course"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isBrotherOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isBrotherOf">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/personal-ontology#hasSibling"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isEmploymentOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isEmploymentOf">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Employment"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isFatherOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isFatherOf">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/personal-ontology#isParentOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isGrantedBy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isGrantedBy">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Bachelors"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#University"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isHobbyOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isHobbyOf">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Activity"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isLanguageProficiencyOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isLanguageProficiencyOf">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/personal-ontology#isProficiencyOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#LanguageProficiency"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isLocatedIn -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isLocatedIn">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#isLocationOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/personal-ontology#Institution"/>
                    <rdf:Description rdf:about="http://www.example.org/personal-ontology#Person"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Location"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isLocationOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isLocationOf">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Location"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/personal-ontology#Institution"/>
                    <rdf:Description rdf:about="http://www.example.org/personal-ontology#Person"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isMotherOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isMotherOf">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/personal-ontology#isParentOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isParentOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isParentOf">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isPartOfProgram -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isPartOfProgram">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Course"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#AcademicProgram"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isProficiencyOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isProficiencyOf">
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isRoleOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isRoleOf">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Role"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Employment"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isSisterOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isSisterOf">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/personal-ontology#hasSibling"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isSkillProficiencyOf -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isSkillProficiencyOf">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/personal-ontology#isProficiencyOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#SkillProficiency"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isTaughtInCourse -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isTaughtInCourse">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#teachesSkill"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Skill"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Course"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#isUsedInProject -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#isUsedInProject">
        <owl:inverseOf rdf:resource="http://www.example.org/personal-ontology#usesSkill"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Skill"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Project"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#locatedInCountry -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#locatedInCountry">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/personal-ontology#isLocatedIn"/>
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#City"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Country"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#ofLanguage -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#ofLanguage">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#LanguageProficiency"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Language"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#ofSkill -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#ofSkill">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#SkillProficiency"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Skill"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#partOfCourse -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#partOfCourse">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#AcademicProject"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Course"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#speaksLanguage -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#speaksLanguage">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Language"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#teachesSkill -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#teachesSkill">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Course"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Skill"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/personal-ontology#usesSkill -->

    <owl:ObjectProperty rdf:about="http://www.example.org/personal-ontology#usesSkill">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Project"/>
        <rdfs:range rdf:resource="http://www.example.org/personal-ontology#Skill"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.example.org/personal-ontology#hasBirthDate -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/personal-ontology#hasBirthDate">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/personal-ontology#hasDepartment -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/personal-ontology#hasDepartment">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Employment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/personal-ontology#hasEndDate -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/personal-ontology#hasEndDate">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Employment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/personal-ontology#hasName -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/personal-ontology#hasName">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/personal-ontology#Course"/>
                    <rdf:Description rdf:about="http://www.example.org/personal-ontology#Institution"/>
                    <rdf:Description rdf:about="http://www.example.org/personal-ontology#Person"/>
                    <rdf:Description rdf:about="http://www.example.org/personal-ontology#Project"/>
                    <rdf:Description rdf:about="http://www.example.org/personal-ontology#Role"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.example.org/personal-ontology#hasStartDate -->

    <owl:DatatypeProperty rdf:about="http://www.example.org/personal-ontology#hasStartDate">
        <rdfs:domain rdf:resource="http://www.example.org/personal-ontology#Employment"/>
