#    Classes
#################################################################

###  http://example.invalid/ontologies/ont.owl#CreativeSkill
<http://example.invalid/ontologies/ont.owl#CreativeSkill> rdf:type owl:Class ;
                                                          rdfs:subClassOf :Skill .


###  http://www.example.org/personal-ontology#AcademicInstitution
:AcademicInstitution rdf:type owl:Class ;
                     rdfs:subClassOf :Institution ;
                     owl:disjointWith :Organization .


###  http://www.example.org/personal-ontology#AcademicProgram
:AcademicProgram rdf:type owl:Class .


###  http://www.example.org/personal-ontology#AcademicProject
:AcademicProject rdf:type owl:Class ;
                 rdfs:subClassOf :Project ;
                 owl:disjointWith :PersonalProject .


###  http://www.example.org/personal-ontology#Activity
:Activity rdf:type owl:Class .


###  http://www.example.org/personal-ontology#Bachelors
:Bachelors rdf:type owl:Class ;
           rdfs:subClassOf :AcademicProgram ;
           owl:disjointWith :ExchangeSemester .


###  http://www.example.org/personal-ontology#City
:City rdf:type owl:Class ;
      rdfs:subClassOf :Location ;
      owl:disjointWith :Country .


###  http://www.example.org/personal-ontology#Country
:Country rdf:type owl:Class ;
         rdfs:subClassOf :Location .


###  http://www.example.org/personal-ontology#Course
:Course rdf:type owl:Class .


###  http://www.example.org/personal-ontology#Employment
:Employment rdf:type owl:Class .


###  http://www.example.org/personal-ontology#ExchangeSemester
:ExchangeSemester rdf:type owl:Class ;
                  rdfs:subClassOf :AcademicProgram .


###  http://www.example.org/personal-ontology#Institution
:Institution rdf:type owl:Class .


###  http://www.example.org/personal-ontology#Language
:Language rdf:type owl:Class .


###  http://www.example.org/personal-ontology#LanguageProficiency
:LanguageProficiency rdf:type owl:Class .


###  http://www.example.org/personal-ontology#Location
:Location rdf:type owl:Class .


###  http://www.example.org/personal-ontology#Organization
:Organization rdf:type owl:Class ;
              rdfs:subClassOf :Institution .


###  http://www.example.org/personal-ontology#Person
:Person rdf:type owl:Class .


###  http://www.example.org/personal-ontology#PersonalProject
:PersonalProject rdf:type owl:Class ;
                 rdfs:subClassOf :Project .


###  http://www.example.org/personal-ontology#ProgrammingLanguage
:ProgrammingLanguage rdf:type owl:Class ;
                     rdfs:subClassOf :TechnicalSkill .


###  http://www.example.org/personal-ontology#Project
:Project rdf:type owl:Class .


###  http://www.example.org/personal-ontology#Role
:Role rdf:type owl:Class .


###  http://www.example.org/personal-ontology#Skill
:Skill rdf:type owl:Class .


###  http://www.example.org/personal-ontology#SkillProficiency
:SkillProficiency rdf:type owl:Class .


###  http://www.example.org/personal-ontology#SoftSkill
:SoftSkill rdf:type owl:Class ;
           rdfs:subClassOf :Skill .


###  http://www.example.org/personal-ontology#TechnicalSkill
:TechnicalSkill rdf:type owl:Class ;
                rdfs:subClassOf :Skill .


###  http://www.example.org/personal-ontology#University
:University rdf:type owl:Class ;
            rdfs:subClassOf :AcademicInstitution .


