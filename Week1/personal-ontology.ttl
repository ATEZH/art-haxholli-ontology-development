@prefix : <http://www.example.org/personal-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.example.org/personal-ontology#> .

<http://www.example.org/personal-ontology> rdf:type owl:Ontology ;
                                            rdfs:comment "Ontology of Art Haxholli" .

#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.example.org/personal-ontology#atOrganization
:atOrganization rdf:type owl:ObjectProperty ;
                owl:inverseOf :offersEmployment ;
                rdfs:domain :Employment ;
                rdfs:range :Institution .


###  http://www.example.org/personal-ontology#completedProgram
:completedProgram rdf:type owl:ObjectProperty ;
                  owl:inverseOf :hasGraduate ;
                  rdfs:domain :Person ;
                  rdfs:range :AcademicProgram .


###  http://www.example.org/personal-ontology#contributedTo
:contributedTo rdf:type owl:ObjectProperty ;
               owl:inverseOf :hasContributor ;
               rdfs:domain :Person ;
               rdfs:range :Project .


###  http://www.example.org/personal-ontology#grants
:grants rdf:type owl:ObjectProperty ;
        owl:inverseOf :isGrantedBy ;
        rdfs:domain :University ;
        rdfs:range :Bachelors .


###  http://www.example.org/personal-ontology#hasAcademicProject
:hasAcademicProject rdf:type owl:ObjectProperty ;
                    owl:inverseOf :partOfCourse ;
                    rdfs:domain :Course ;
                    rdfs:range :AcademicProject .


###  http://www.example.org/personal-ontology#hasBrother
:hasBrother rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasSibling ;
            owl:inverseOf :isBrotherOf ;
            rdfs:domain :Person ;
            rdfs:range :Person .


###  http://www.example.org/personal-ontology#hasCity
:hasCity rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :isLocationOf ;
         owl:inverseOf :locatedInCountry ;
         rdfs:domain :Country ;
         rdfs:range :City .


###  http://www.example.org/personal-ontology#hasContributor
:hasContributor rdf:type owl:ObjectProperty ;
                rdfs:domain :Project ;
                rdfs:range :Person .


###  http://www.example.org/personal-ontology#hasEmployment
:hasEmployment rdf:type owl:ObjectProperty ;
               owl:inverseOf :isEmploymentOf ;
               rdfs:domain :Person ;
               rdfs:range :Employment .


###  http://www.example.org/personal-ontology#hasFather
:hasFather rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasParent ;
           owl:inverseOf :isFatherOf ;
           rdfs:domain :Person ;
           rdfs:range :Person .


###  http://www.example.org/personal-ontology#hasGraduate
:hasGraduate rdf:type owl:ObjectProperty ;
             rdfs:domain :AcademicProgram ;
             rdfs:range :Person .


###  http://www.example.org/personal-ontology#hasHobby
:hasHobby rdf:type owl:ObjectProperty ;
          owl:inverseOf :isHobbyOf ;
          rdfs:domain :Person ;
          rdfs:range :Activity .


###  http://www.example.org/personal-ontology#hasLanguageProficiency
:hasLanguageProficiency rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :hasProficiency ;
                        owl:inverseOf :isLanguageProficiencyOf ;
                        rdfs:domain :Person ;
                        rdfs:range :LanguageProficiency .


###  http://www.example.org/personal-ontology#hasMother
:hasMother rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasParent ;
           owl:inverseOf :isMotherOf ;
           rdfs:domain :Person ;
           rdfs:range :Person .


###  http://www.example.org/personal-ontology#hasParent
:hasParent rdf:type owl:ObjectProperty ;
           owl:inverseOf :isParentOf ;
           rdfs:domain :Person ;
           rdfs:range :Person .


###  http://www.example.org/personal-ontology#hasProficiency
:hasProficiency rdf:type owl:ObjectProperty ;
                owl:inverseOf :isProficiencyOf ;
                rdfs:domain :Person .


###  http://www.example.org/personal-ontology#hasProficiencyRecord
:hasProficiencyRecord rdf:type owl:ObjectProperty ;
                      owl:inverseOf :ofLanguage ;
                      rdfs:domain :Language ;
                      rdfs:range :LanguageProficiency .


###  http://www.example.org/personal-ontology#hasRole
:hasRole rdf:type owl:ObjectProperty ;
         owl:inverseOf :isRoleOf ;
         rdfs:domain :Employment ;
         rdfs:range :Role .


###  http://www.example.org/personal-ontology#hasSibling
:hasSibling rdf:type owl:ObjectProperty ,
                     owl:SymmetricProperty ;
            rdfs:domain :Person ;
            rdfs:range :Person .


###  http://www.example.org/personal-ontology#hasSister
:hasSister rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasSibling ;
           owl:inverseOf :isSisterOf ;
           rdfs:domain :Person ;
           rdfs:range :Person .


###  http://www.example.org/personal-ontology#hasSkillProficiency
:hasSkillProficiency rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasProficiency ;
                     owl:inverseOf :isSkillProficiencyOf ;
                     rdfs:domain :Person ;
                     rdfs:range :SkillProficiency .


###  http://www.example.org/personal-ontology#hasSkillProficiencyRecord
:hasSkillProficiencyRecord rdf:type owl:ObjectProperty ;
                           owl:inverseOf :ofSkill ;
                           rdfs:domain :Skill ;
                           rdfs:range :SkillProficiency .


###  http://www.example.org/personal-ontology#includesCourse
:includesCourse rdf:type owl:ObjectProperty ;
                owl:inverseOf :isPartOfProgram ;
                rdfs:domain :AcademicProgram ;
                rdfs:range :Course .


###  http://www.example.org/personal-ontology#isBrotherOf
:isBrotherOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasSibling ;
             rdfs:domain :Person ;
             rdfs:range :Person .


###  http://www.example.org/personal-ontology#isEmploymentOf
:isEmploymentOf rdf:type owl:ObjectProperty ;
                rdfs:domain :Employment ;
                rdfs:range :Person .


###  http://www.example.org/personal-ontology#isFatherOf
:isFatherOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :isParentOf ;
            rdfs:domain :Person ;
            rdfs:range :Person .


###  http://www.example.org/personal-ontology#isGrantedBy
:isGrantedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :Bachelors ;
             rdfs:range :University .


###  http://www.example.org/personal-ontology#isHobbyOf
:isHobbyOf rdf:type owl:ObjectProperty ;
           rdfs:domain :Activity ;
           rdfs:range :Person .


###  http://www.example.org/personal-ontology#isLanguageProficiencyOf
:isLanguageProficiencyOf rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :isProficiencyOf ;
                         rdfs:domain :LanguageProficiency ;
                         rdfs:range :Person .


###  http://www.example.org/personal-ontology#isLocatedIn
:isLocatedIn rdf:type owl:ObjectProperty ;
             owl:inverseOf :isLocationOf ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Institution
                                         :Person
                                       )
                         ] ;
             rdfs:range :Location .


###  http://www.example.org/personal-ontology#isLocationOf
:isLocationOf rdf:type owl:ObjectProperty ;
              rdfs:domain :Location ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( :Institution
                                         :Person
                                       )
                         ] .


###  http://www.example.org/personal-ontology#isMotherOf
:isMotherOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :isParentOf ;
            rdfs:domain :Person ;
            rdfs:range :Person .


###  http://www.example.org/personal-ontology#isParentOf
:isParentOf rdf:type owl:ObjectProperty ;
            rdfs:domain :Person ;
            rdfs:range :Person .


###  http://www.example.org/personal-ontology#isPartOfProgram
:isPartOfProgram rdf:type owl:ObjectProperty ;
                 rdfs:domain :Course ;
                 rdfs:range :AcademicProgram .


###  http://www.example.org/personal-ontology#isProficiencyOf
:isProficiencyOf rdf:type owl:ObjectProperty ;
                 rdfs:range :Person .


###  http://www.example.org/personal-ontology#isRoleOf
:isRoleOf rdf:type owl:ObjectProperty ;
          rdfs:domain :Role ;
          rdfs:range :Employment .


###  http://www.example.org/personal-ontology#isSisterOf
:isSisterOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasSibling ;
            rdfs:domain :Person ;
            rdfs:range :Person .


###  http://www.example.org/personal-ontology#isSkillProficiencyOf
:isSkillProficiencyOf rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :isProficiencyOf ;
                      rdfs:domain :SkillProficiency ;
                      rdfs:range :Person .


###  http://www.example.org/personal-ontology#isTaughtInCourse
:isTaughtInCourse rdf:type owl:ObjectProperty ;
                  owl:inverseOf :teachesSkill ;
                  rdfs:domain :Skill ;
                  rdfs:range :Course .


###  http://www.example.org/personal-ontology#isUsedInProject
:isUsedInProject rdf:type owl:ObjectProperty ;
                 owl:inverseOf :usesSkill ;
                 rdfs:domain :Skill ;
                 rdfs:range :Project .


###  http://www.example.org/personal-ontology#locatedInCountry
:locatedInCountry rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :isLocatedIn ;
                  rdfs:domain :City ;
                  rdfs:range :Country .


###  http://www.example.org/personal-ontology#ofLanguage
:ofLanguage rdf:type owl:ObjectProperty ;
            rdfs:domain :LanguageProficiency ;
            rdfs:range :Language .


###  http://www.example.org/personal-ontology#ofSkill
:ofSkill rdf:type owl:ObjectProperty ;
         rdfs:domain :SkillProficiency ;
         rdfs:range :Skill .


###  http://www.example.org/personal-ontology#offersEmployment
:offersEmployment rdf:type owl:ObjectProperty ;
                  rdfs:domain :Institution ;
                  rdfs:range :Employment .


###  http://www.example.org/personal-ontology#partOfCourse
:partOfCourse rdf:type owl:ObjectProperty ;
              rdfs:domain :AcademicProject ;
              rdfs:range :Course .


###  http://www.example.org/personal-ontology#speaksLanguage
:speaksLanguage rdf:type owl:ObjectProperty ;
                rdfs:domain :Person ;
                rdfs:range :Language .


###  http://www.example.org/personal-ontology#teachesSkill
:teachesSkill rdf:type owl:ObjectProperty ;
              rdfs:domain :Course ;
              rdfs:range :Skill .


###  http://www.example.org/personal-ontology#usesSkill
:usesSkill rdf:type owl:ObjectProperty ;
           rdfs:domain :Project ;
           rdfs:range :Skill .


#################################################################
#    Data properties
#################################################################

###  http://www.example.org/personal-ontology#hasBirthDate
:hasBirthDate rdf:type owl:DatatypeProperty ;
              rdfs:domain :Person ;
              rdfs:range xsd:date .


###  http://www.example.org/personal-ontology#hasDepartment
:hasDepartment rdf:type owl:DatatypeProperty ;
               rdfs:domain :Employment ;
               rdfs:range xsd:string .


###  http://www.example.org/personal-ontology#hasEndDate
:hasEndDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :Employment ;
            rdfs:range xsd:date .


###  http://www.example.org/personal-ontology#hasName
:hasName rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :Course
                                     :Institution
                                     :Person
                                     :Project
                                     :Role
                                   )
                     ] ;
         rdfs:range xsd:string .


###  http://www.example.org/personal-ontology#hasStartDate
:hasStartDate rdf:type owl:DatatypeProperty ;
              rdfs:domain :Employment ;
              rdfs:range xsd:date .


###  http://www.example.org/personal-ontology#ofLevel
:ofLevel rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :LanguageProficiency
                                     :SkillProficiency
                                   )
                     ] ;
         rdfs:range xsd:string .


