#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <http://example.invalid/ontologies/ont.owl#CreativeSkill>
                :SoftSkill
                :TechnicalSkill
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AcademicProgram
                :Activity
                :Course
                :Employment
                :Institution
                :Language
                :LanguageProficiency
                :Location
                :Person
                :Project
                :Role
                :Skill
                :SkillProficiency
              )
] .


