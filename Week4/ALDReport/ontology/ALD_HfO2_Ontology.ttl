:hasNumericUpperBound rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Measurement ;
                      rdfs:range xsd:decimal ;
                      rdfs:label "has numeric upper bound" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasPatternedAreaUm2
:hasPatternedAreaUm2 rdf:type owl:DatatypeProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :Electrical_Qualification_Protocol
                                                 :Equipment
                                                 :Measurement
                                                 :Starting_Condition
                                               )
                                 ] ;
                     rdfs:range xsd:decimal ;
                     rdfs:label "has patterned area um2" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasPlasmaPowerW
:hasPlasmaPowerW rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Co_Reactant_Pulse_Step ;
                 rdfs:range xsd:decimal ;
                 rdfs:label "has plasma power w" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasPrecursorSourceTemperatureC
:hasPrecursorSourceTemperatureC rdf:type owl:DatatypeProperty ;
                                rdfs:domain :Hf_Precursor_Pulse_Step ;
                                rdfs:range xsd:decimal ;
                                rdfs:label "has precursor source temperature c" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasProcessDurationS
:hasProcessDurationS rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Post_Deposition_Treatment_Step ;
                     rdfs:range xsd:decimal ;
                     rdfs:label "has process duration s" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasProcessPressureMbar
:hasProcessPressureMbar rdf:type owl:DatatypeProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :First_Purge_Step
                                                    :Hf_Precursor_Pulse_Step
                                                  )
                                    ] ;
                        rdfs:range xsd:decimal ;
                        rdfs:label "has process pressure mbar" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasProcessTemperatureC
:hasProcessTemperatureC rdf:type owl:DatatypeProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :Co_Reactant_Pulse_Step
                                                    :Cycle_Repetition_Specification
                                                    :Electrode_Integration_Step
                                                    :Hf_Precursor_Pulse_Step
                                                    :Post_Deposition_Treatment_Step
                                                    :Starting_Condition
                                                  )
                                    ] ;
                        rdfs:range xsd:decimal ;
                        rdfs:label "has process temperature c" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasPulseTimeS
:hasPulseTimeS rdf:type owl:DatatypeProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :Co_Reactant_Pulse_Step
                                           :Hf_Precursor_Pulse_Step
                                         )
                           ] ;
               rdfs:range xsd:decimal ;
               rdfs:label "has pulse time s" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasPulseWidthS
:hasPulseWidthS rdf:type owl:DatatypeProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :Electrical_Qualification_Protocol
                                            :Measurement
                                          )
                            ] ;
                rdfs:range xsd:decimal ;
                rdfs:label "has pulse width s" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasPurgeTimeS
:hasPurgeTimeS rdf:type owl:DatatypeProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :First_Purge_Step
                                           :Second_Purge_Step
                                         )
                           ] ;
               rdfs:range xsd:decimal ;
               rdfs:label "has purge time s" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasReactorTypeText
:hasReactorTypeText rdf:type owl:DatatypeProperty ;
                    rdfs:domain :ALD_Reactor ;
                    rdfs:range xsd:string ;
                    rdfs:label "has reactor type text" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasReportedPhaseName
:hasReportedPhaseName rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Crystalline_Phase_Measurement ;
                      rdfs:range xsd:string ;
                      rdfs:label "has reported phase name" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasReportedValueText
:hasReportedValueText rdf:type owl:DatatypeProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :Equipment
                                                  :Measurement
                                                  :Process_Specification
                                                )
                                  ] ;
                      rdfs:range xsd:string ;
                      rdfs:label "has reported value text" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasSeedPlacementText
:hasSeedPlacementText rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Interface_Preparation_Step ;
                      rdfs:range xsd:string ;
                      rdfs:label "has seed placement text" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasSpecimenDescription
:hasSpecimenDescription rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Measurement ;
                        rdfs:range xsd:string ;
                        rdfs:label "has specimen description" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasTemperatureC
:hasTemperatureC rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Measurement ;
                 rdfs:range xsd:decimal ;
                 rdfs:label "has temperature c" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasToolNameText
:hasToolNameText rdf:type owl:DatatypeProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :Co_Reactant_Pulse_Step
                                             :Equipment
                                             :Measurement
                                           )
                             ] ;
                 rdfs:range xsd:string ;
                 rdfs:label "has tool name text" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasUnit
:hasUnit rdf:type owl:DatatypeProperty ;
         rdfs:domain :Measurement ;
         rdfs:range xsd:string ;
         rdfs:label "has unit" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasWaferDiameterMm
:hasWaferDiameterMm rdf:type owl:DatatypeProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :ALD_Cycle_Recipe
                                                :Equipment
                                                :Interface_Preparation_Step
                                                :Starting_Condition
                                              )
                                ] ;
                    rdfs:range xsd:decimal ;
                    rdfs:label "has wafer diameter mm" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasWaveform
:hasWaveform rdf:type owl:DatatypeProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Electrical_Qualification_Protocol
                                         :Measurement
                                       )
                         ] ;
             rdfs:range xsd:string ;
             rdfs:label "has waveform" .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/opxhs/ald-hfo2-capacitor#ALD_Cycle_Element_Specification
:ALD_Cycle_Element_Specification rdf:type owl:Class ;
                                 rdfs:subClassOf :ALD_Film_Formation_Specification ;
                                 rdfs:comment "A specification of one position within an ALD cycle." ;
                                 rdfs:label "ALD Cycle Element Specification" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#ALD_Cycle_Recipe
:ALD_Cycle_Recipe rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( :ALD_Film_Formation_Specification
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :hasProcessPart ;
                                                               owl:someValuesFrom :Co_Reactant_Pulse_Step
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :hasProcessPart ;
                                                               owl:someValuesFrom :Hf_Precursor_Pulse_Step
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :hasProcessPart ;
                                                               owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                   owl:unionOf ( :Co_Reactant_Pulse_Step
                                                                                                 :Cycle_Repetition_Specification
                                                                                                 :First_Purge_Step
                                                                                                 :Hf_Precursor_Pulse_Step
                                                                                                 :Second_Purge_Step
                                                                                               )
                                                                                 ]
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf :ALD_Film_Formation_Specification ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :implementedInReactor ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :ALD_Reactor
                                  ] ;
                  rdfs:comment "An ALD film-formation specification with an Hf-precursor-pulse part and a co-reactant-pulse part." ;
                  rdfs:label "ALD Cycle Recipe" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#ALD_Film_Formation_Specification
:ALD_Film_Formation_Specification rdf:type owl:Class ;
                                  rdfs:subClassOf :Process_Specification ;
                                  rdfs:comment "A specification governing ALD chemistry, timing, temperature, pressure, or repetition." ;
                                  rdfs:label "ALD Film Formation Specification" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#ALD_Reactor
:ALD_Reactor rdf:type owl:Class ;
             rdfs:subClassOf :Deposition_Tool ;
             rdfs:comment "A reactor platform used for ALD or PEALD growth." ;
             rdfs:label "ALD Reactor" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Co_Reactant_Pulse_Step
:Co_Reactant_Pulse_Step rdf:type owl:Class ;
                        rdfs:subClassOf :ALD_Cycle_Element_Specification ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :usesOxidant ;
                                          owl:allValuesFrom :Oxidant
                                        ] ;
                        rdfs:comment "An oxidant or plasma exposure paired with a metal or dopant subcycle." ;
                        rdfs:label "Co Reactant Pulse Step" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Conformality_Uniformity_Measurement
:Conformality_Uniformity_Measurement rdf:type owl:Class ;
                                     rdfs:subClassOf :Measurement ;
                                     rdfs:comment "A step-coverage, spatial-uniformity, or nonuniformity result." ;
                                     rdfs:label "Conformality Uniformity Measurement" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Crystalline_Phase_Measurement
:Crystalline_Phase_Measurement rdf:type owl:Class ;
                               rdfs:subClassOf :Measurement ;
                               rdfs:comment "A phase-sensitive structural output without a phase taxonomy." ;
                               rdfs:label "Crystalline Phase Measurement" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Cycle_Repetition_Specification
:Cycle_Repetition_Specification rdf:type owl:Class ;
                                rdfs:subClassOf :ALD_Film_Formation_Specification ;
                                rdfs:comment "A supercycle count, block size, ratio, or repeated-half-cycle architecture." ;
                                rdfs:label "Cycle Repetition Specification" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Defect_Reliability_Measurement
:Defect_Reliability_Measurement rdf:type owl:Class ;
                                rdfs:subClassOf :Measurement ;
                                rdfs:comment "A vacancy, endurance, fatigue, retention, or breakdown-limited reliability result." ;
                                rdfs:label "Defect Reliability Measurement" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Deposition_Tool
:Deposition_Tool rdf:type owl:Class ;
                 rdfs:subClassOf :Equipment ;
                 rdfs:comment "Equipment used for oxide or electrode deposition." ;
                 rdfs:label "Deposition Tool" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Electrical_Qualification_Protocol
:Electrical_Qualification_Protocol rdf:type owl:Class ;
                                   rdfs:subClassOf :Process_Specification ;
                                   rdfs:comment "A conditioning, stressing, cycling, or readout protocol with waveform and electrode setup." ;
                                   rdfs:label "Electrical Qualification Protocol" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Electrical_Test_Tool
:Electrical_Test_Tool rdf:type owl:Class ;
                      rdfs:subClassOf :Equipment ;
                      rdfs:comment "Equipment used for ferroelectric, current, breakdown, or parameter measurement." ;
                      rdfs:label "Electrical Test Tool" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Electrode_Deposition_Tool
:Electrode_Deposition_Tool rdf:type owl:Class ;
                           rdfs:subClassOf :Deposition_Tool ;
                           rdfs:comment "Sputtering, PVD, evaporation, or equivalent electrode-deposition equipment." ;
                           rdfs:label "Electrode Deposition Tool" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Electrode_Integration_Step
:Electrode_Integration_Step rdf:type owl:Class ;
                            rdfs:subClassOf :Post_Deposition_Integration_Specification ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :hasElectrodeMaterial ;
                                              owl:allValuesFrom :Electrode_Material
                                            ] ;
                            rdfs:comment "A position-specific electrode, cap, contact, or hard-mask integration operation." ;
                            rdfs:label "Electrode Integration Step" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Electrode_Material
:Electrode_Material rdf:type owl:Class ;
                    rdfs:subClassOf :Material ;
                    rdfs:comment "A material serving as a bottom electrode, top electrode, cap, or electrical contact." ;
                    rdfs:label "Electrode Material" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Equipment
:Equipment rdf:type owl:Class ;
           rdfs:comment "A tool, reactor, instrument, or explicitly reported equipment chain." ;
           rdfs:label "Equipment" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Film_Material
:Film_Material rdf:type owl:Class ;
               rdfs:subClassOf :Material ;
               rdfs:comment "An HfO2-based film or reported composite film family." ;
               rdfs:label "Film Material" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Film_Thickness_Uniformity_Measurement
:Film_Thickness_Uniformity_Measurement rdf:type owl:Class ;
                                       rdfs:subClassOf :Measurement ;
                                       rdfs:comment "A thickness or spatial-thickness output with sampling context." ;
                                       rdfs:label "Film Thickness Uniformity Measurement" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#First_Purge_Step
:First_Purge_Step rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( :ALD_Cycle_Element_Specification
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :directlyFollows ;
                                                               owl:someValuesFrom :Hf_Precursor_Pulse_Step
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :directlyPrecedes ;
                                                               owl:someValuesFrom :Co_Reactant_Pulse_Step
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf :ALD_Cycle_Element_Specification ;
                  rdfs:comment "A cycle element directly after an Hf-precursor pulse and directly before the paired co-reactant pulse." ;
                  rdfs:label "First Purge Step" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Hf_Precursor
:Hf_Precursor rdf:type owl:Class ;
              rdfs:subClassOf :Material ;
              rdfs:comment "An Hf-bearing chemical precursor used in a deposition half-cycle." ;
              rdfs:label "Hf Precursor" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Hf_Precursor_Pulse_Step
:Hf_Precursor_Pulse_Step rdf:type owl:Class ;
                         rdfs:subClassOf :ALD_Cycle_Element_Specification ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :usesPrecursor ;
                                           owl:allValuesFrom :Hf_Precursor
                                         ] ;
                         rdfs:comment "The first half-cycle delivering an Hf precursor under route-specific conditions." ;
                         rdfs:label "Hf Precursor Pulse Step" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Hysteresis_Reliability_Measurement
:Hysteresis_Reliability_Measurement rdf:type owl:Class ;
                                    rdfs:subClassOf :Measurement ;
                                    rdfs:comment "A hysteresis, PUND, switching, wake-up, fatigue, cycling, or retention output." ;
                                    rdfs:label "Hysteresis Reliability Measurement" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Interface_Defect_Measurement
:Interface_Defect_Measurement rdf:type owl:Class ;
                              rdfs:subClassOf :Measurement ;
                              rdfs:comment "An interface morphology, composition, impurity, or depth-profile output." ;
                              rdfs:label "Interface Defect Measurement" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Interface_Material
:Interface_Material rdf:type owl:Class ;
                    rdfs:subClassOf :Material ;
                    rdfs:comment "A seed layer, interlayer, insertion layer, or interface-localized material." ;
                    rdfs:label "Interface Material" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Interface_Preparation_Step
:Interface_Preparation_Step rdf:type owl:Class ;
                            rdfs:subClassOf :Predeposition_Preparation ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty :hasInterfaceMaterial ;
                                              owl:allValuesFrom :Interface_Material
                                            ] ;
                            rdfs:comment "An interlayer, seed-layer, superlattice-start, or dopant-layer preparation." ;
                            rdfs:label "Interface Preparation Step" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Leakage_Breakdown_Measurement
:Leakage_Breakdown_Measurement rdf:type owl:Class ;
                               rdfs:subClassOf :Measurement ;
                               rdfs:comment "A sweep, spatial-leakage, or time-zero-breakdown output." ;
                               rdfs:label "Leakage Breakdown Measurement" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Leakage_Current_Measurement
:Leakage_Current_Measurement rdf:type owl:Class ;
                             rdfs:subClassOf :Measurement ;
                             rdfs:comment "A leakage-current result under stated bias and conditioning." ;
                             rdfs:label "Leakage Current Measurement" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Material
:Material rdf:type owl:Class ;
          rdfs:comment "A substance participating in the documented module flow." ;
          rdfs:label "Material" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Measurement
:Measurement rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :hasSpecimenMaterial ;
                               owl:allValuesFrom :Film_Material
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasUnit ;
                               owl:allValuesFrom xsd:string
                             ] ;
             rdfs:comment "A context-bound n-ary record of a measured or qualified output, method, specimen, conditions, and limitations." ;
             rdfs:label "Measurement" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Metrology_Tool
:Metrology_Tool rdf:type owl:Class ;
                rdfs:subClassOf :Equipment ;
                rdfs:comment "Structural, chemical, thickness, or microscopy instrumentation." ;
                rdfs:label "Metrology Tool" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Oxidant
:Oxidant rdf:type owl:Class ;
         rdfs:subClassOf :Material ;
         rdfs:comment "Water, ozone, oxygen plasma, or another reported oxidizing co-reactant." ;
         rdfs:label "Oxidant" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#PEALD_Reactor
:PEALD_Reactor rdf:type owl:Class ;
               rdfs:subClassOf :ALD_Reactor ;
               rdfs:comment "An ALD reactor used in a reported plasma-enhanced configuration." ;
               rdfs:label "PEALD Reactor" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Polarisation_Coercive_Measurement
:Polarisation_Coercive_Measurement rdf:type owl:Class ;
                                   rdfs:subClassOf :Measurement ;
                                   rdfs:comment "A polarization, switched-charge, coercive-field, or coercive-voltage result." ;
                                   rdfs:label "Polarisation Coercive Measurement" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Post_Deposition_Integration_Specification
:Post_Deposition_Integration_Specification rdf:type owl:Class ;
                                           rdfs:subClassOf :Process_Specification ;
                                           rdfs:comment "A specification for stack processing after film deposition." ;
                                           rdfs:label "Post Deposition Integration Specification" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Post_Deposition_Treatment_Step
:Post_Deposition_Treatment_Step rdf:type owl:Class ;
                                rdfs:subClassOf :Post_Deposition_Integration_Specification ;
                                rdfs:comment "An anneal, plasma treatment, or related operation identified together with stack state." ;
                                rdfs:label "Post Deposition Treatment Step" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Predeposition_Preparation
:Predeposition_Preparation rdf:type owl:Class ;
                           rdfs:subClassOf :Process_Specification ;
                           rdfs:comment "A preparation conducted before ALD film formation." ;
                           rdfs:label "Predeposition Preparation" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Process_Specification
:Process_Specification rdf:type owl:Class ;
                       rdfs:comment "A documented condition, recipe, procedure, step, or protocol within the capacitor module." ;
                       rdfs:label "Process Specification" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Second_Purge_Step
:Second_Purge_Step rdf:type owl:Class ;
                   rdfs:subClassOf :ALD_Cycle_Element_Specification ;
                   rdfs:comment "A purge following a co-reactant exposure." ;
                   rdfs:label "Second Purge Step" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Starting_Condition
:Starting_Condition rdf:type owl:Class ;
                    rdfs:subClassOf :Process_Specification ;
                    rdfs:comment "An initial film, composition, temperature, thickness, wafer, or device-size condition." ;
                    rdfs:label "Starting Condition" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Surface_Preclean_Step
:Surface_Preclean_Step rdf:type owl:Class ;
                       rdfs:subClassOf :Predeposition_Preparation ;
                       rdfs:comment "A cleaning or exposure-control operation applied before deposition." ;
                       rdfs:label "Surface Preclean Step" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Thermal_ALD_Reactor
:Thermal_ALD_Reactor rdf:type owl:Class ;
                     rdfs:subClassOf :ALD_Reactor ;
                     rdfs:comment "An ALD reactor used in a reported thermal-ALD configuration." ;
                     rdfs:label "Thermal ALD Reactor" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Thermal_Tool
:Thermal_Tool rdf:type owl:Class ;
              rdfs:subClassOf :Equipment ;
              rdfs:comment "Equipment used for RTA, RTP, or furnace treatment." ;
              rdfs:label "Thermal Tool" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Thickness_Growth_Measurement
:Thickness_Growth_Measurement rdf:type owl:Class ;
                              rdfs:subClassOf :Measurement ;
                              rdfs:comment "A film-thickness or growth-per-cycle result retaining chemistry and temperature context." ;
                              rdfs:label "Thickness Growth Measurement" .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/opxhs/ald-hfo2-capacitor#Al2O3_insertion_interface_preparation_schroeder2023road
:Al2O3_insertion_interface_preparation_schroeder2023road rdf:type owl:NamedIndividual ,
                                                                  :Interface_Preparation_Step ;
                                                         :hasConditionText "40 nm thick HZO film with Al2O3 interlayer at middle | electrode/HfO2 interface diffusion barrier" ,
                                                                           "Internal dielectric/diffusion barrier; voltage-division and depolarization tradeoff." ;
                                                         :hasMaterialDesignation "1 nm thick dielectric Al2O3 layer inserted in middle of 40 nm thick HZO | dielectric diffusion barrier such as Al2O3 helps avoid defect migration across electrode interface" ;
                                                         rdfs:label "Al2O3 insertion interface preparation" ;
                                                         :derivedFrom "S2-017; S2-029; schroeder2023road" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Allwin21_AccuThermo_AW_610_T3_4_R08_choi2025purge
:Allwin21_AccuThermo_AW_610_T3_4_R08_choi2025purge rdf:type owl:NamedIndividual ,
                                                            :Thermal_Tool ;
                                                   :hasConditionText "Rapid thermal annealing." ,
                                                                     "rapid thermal anneal instrument used" ;
                                                   :hasToolNameText "Allwin21 AccuThermo AW 610" ;
                                                   rdfs:label "Allwin21 AccuThermo AW 610 — choi2025purge" ;
                                                   :derivedFrom "S5-035; choi2025purge" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#Ar_first_purge_choi2025purge
:Ar_first_purge_choi2025purge rdf:type owl:NamedIndividual ,
                                       :First_Purge_Step ;
                              :directlyFollows :TEMA_Hf_PEALD_pulse_choi2025purge ;
                              :directlyPrecedes :O2_plasma_co_reactant_pulse_choi2025purge ;
