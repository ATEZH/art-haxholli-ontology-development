@prefix : <https://w3id.org/opxhs/ald-hfo2-capacitor#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/opxhs/ald-hfo2-capacitor#> .

<https://w3id.org/opxhs/ald-hfo2-capacitor> rdf:type owl:Ontology ;
                                             rdfs:label "FeRAM ALD Deposition ontology" .

#################################################################
#    Annotation properties
#################################################################

###  https://w3id.org/opxhs/ald-hfo2-capacitor#derivedFrom
:derivedFrom rdf:type owl:AnnotationProperty ;
             rdfs:label "derived from" .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/opxhs/ald-hfo2-capacitor#conditionsProcess
:conditionsProcess rdf:type owl:ObjectProperty ;
                   owl:inverseOf :hasStartingCondition ;
                   rdfs:domain :Starting_Condition ;
                   rdfs:range [ rdf:type owl:Class ;
                                owl:unionOf ( :ALD_Film_Formation_Specification
                                              :Electrical_Qualification_Protocol
                                              :Post_Deposition_Integration_Specification
                                              :Predeposition_Preparation
                                            )
                              ] ;
                   rdfs:label "conditions process" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#directlyFollows
:directlyFollows rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :follows ;
                 owl:inverseOf :directlyPrecedes ;
                 rdf:type owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :ALD_Cycle_Element_Specification
                                             :Electrical_Qualification_Protocol
                                             :Electrode_Integration_Step
                                             :Interface_Preparation_Step
                                             :Post_Deposition_Treatment_Step
                                             :Surface_Preclean_Step
                                           )
                             ] ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( :ALD_Cycle_Element_Specification
                                            :Electrical_Qualification_Protocol
                                            :Electrode_Integration_Step
                                            :Interface_Preparation_Step
                                            :Post_Deposition_Treatment_Step
                                            :Surface_Preclean_Step
                                          )
                            ] ;
                 rdfs:label "directly follows" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#directlyPrecedes
:directlyPrecedes rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :precedes ;
                  rdf:type owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :ALD_Cycle_Element_Specification
                                              :Electrical_Qualification_Protocol
                                              :Electrode_Integration_Step
                                              :Interface_Preparation_Step
                                              :Post_Deposition_Treatment_Step
                                              :Surface_Preclean_Step
                                            )
                              ] ;
                  rdfs:range [ rdf:type owl:Class ;
                               owl:unionOf ( :ALD_Cycle_Element_Specification
                                             :Electrical_Qualification_Protocol
                                             :Electrode_Integration_Step
                                             :Interface_Preparation_Step
                                             :Post_Deposition_Treatment_Step
                                             :Surface_Preclean_Step
                                           )
                             ] ;
                  rdfs:label "directly precedes" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#follows
:follows rdf:type owl:ObjectProperty ;
         owl:inverseOf :precedes ;
         rdf:type owl:TransitiveProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :ALD_Cycle_Element_Specification
                                     :Electrical_Qualification_Protocol
                                     :Electrode_Integration_Step
                                     :Interface_Preparation_Step
                                     :Post_Deposition_Treatment_Step
                                     :Surface_Preclean_Step
                                   )
                     ] ;
         rdfs:range [ rdf:type owl:Class ;
                      owl:unionOf ( :ALD_Cycle_Element_Specification
                                    :Electrical_Qualification_Protocol
                                    :Electrode_Integration_Step
                                    :Interface_Preparation_Step
                                    :Post_Deposition_Treatment_Step
                                    :Surface_Preclean_Step
                                  )
                    ] ;
         rdfs:label "follows" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasElectrodeIntegration
:hasElectrodeIntegration rdf:type owl:ObjectProperty ;
                         owl:inverseOf :integratesConfiguration ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( :ALD_Cycle_Recipe
                                                     :Post_Deposition_Treatment_Step
                                                   )
                                     ] ;
                         rdfs:range :Electrode_Integration_Step ;
                         rdfs:label "has electrode integration" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasElectrodeMaterial
:hasElectrodeMaterial rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :usesMaterial ;
                      rdfs:domain :Electrode_Integration_Step ;
                      rdfs:range :Electrode_Material ;
                      rdfs:label "has electrode material" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasFilmMaterial
:hasFilmMaterial rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :ALD_Cycle_Recipe
                                             :Electrode_Integration_Step
                                             :Measurement
                                             :Post_Deposition_Treatment_Step
                                             :Starting_Condition
                                           )
                             ] ;
                 rdfs:range :Film_Material ;
                 rdfs:label "has film material" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasInterfaceMaterial
:hasInterfaceMaterial rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :usesMaterial ;
                      rdfs:domain :Interface_Preparation_Step ;
                      rdfs:range :Interface_Material ;
                      rdfs:label "has interface material" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasInterfacePreparation
:hasInterfacePreparation rdf:type owl:ObjectProperty ;
                         owl:inverseOf :preparesRecipe ;
                         rdfs:domain :ALD_Cycle_Recipe ;
                         rdfs:range :Interface_Preparation_Step ;
                         rdfs:label "has interface preparation" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasPostDepositionTreatment
:hasPostDepositionTreatment rdf:type owl:ObjectProperty ;
                            owl:inverseOf :treatsConfiguration ;
                            rdfs:domain [ rdf:type owl:Class ;
                                          owl:unionOf ( :ALD_Cycle_Recipe
                                                        :Electrode_Integration_Step
                                                      )
                                        ] ;
                            rdfs:range :Post_Deposition_Treatment_Step ;
                            rdfs:label "has post deposition treatment" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasProcessPart
:hasProcessPart rdf:type owl:ObjectProperty ;
                owl:inverseOf :isProcessPartOf ;
                rdf:type owl:TransitiveProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :ALD_Film_Formation_Specification
                                            :Electrical_Qualification_Protocol
                                            :Post_Deposition_Integration_Specification
                                            :Predeposition_Preparation
                                          )
                            ] ;
                rdfs:range :Process_Specification ;
                rdfs:label "has process part" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasResultMeasurement
:hasResultMeasurement rdf:type owl:ObjectProperty ;
                      owl:inverseOf :isResultMeasurementOf ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :ALD_Cycle_Recipe
                                                  :Electrical_Qualification_Protocol
                                                  :Electrode_Integration_Step
                                                  :Post_Deposition_Treatment_Step
                                                )
                                  ] ;
                      rdfs:range :Measurement ;
                      rdfs:label "has result measurement" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasSpecimenMaterial
:hasSpecimenMaterial rdf:type owl:ObjectProperty ;
                     owl:inverseOf :isSpecimenOfMeasurement ;
                     rdfs:domain :Measurement ;
                     rdfs:range :Film_Material ;
                     rdfs:label "has specimen material" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasStartingCondition
:hasStartingCondition rdf:type owl:ObjectProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :ALD_Film_Formation_Specification
                                                  :Electrical_Qualification_Protocol
                                                  :Post_Deposition_Integration_Specification
                                                  :Predeposition_Preparation
                                                )
                                  ] ;
                      rdfs:range :Starting_Condition ;
                      rdfs:label "has starting condition" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hostsRecipe
:hostsRecipe rdf:type owl:ObjectProperty ;
             owl:inverseOf :implementedInReactor ;
             rdfs:domain :ALD_Reactor ;
             rdfs:range :ALD_Cycle_Recipe ;
             rdfs:label "hosts recipe" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#implementedInReactor
:implementedInReactor rdf:type owl:ObjectProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain :ALD_Cycle_Recipe ;
                      rdfs:range :ALD_Reactor ;
                      rdfs:label "implemented in reactor" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#integratesConfiguration
:integratesConfiguration rdf:type owl:ObjectProperty ;
                         rdfs:domain :Electrode_Integration_Step ;
                         rdfs:range [ rdf:type owl:Class ;
                                      owl:unionOf ( :ALD_Cycle_Recipe
                                                    :Post_Deposition_Treatment_Step
                                                  )
                                    ] ;
                         rdfs:label "integrates configuration" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#isEquipmentFor
:isEquipmentFor rdf:type owl:ObjectProperty ;
                owl:inverseOf :usesEquipment ;
                rdfs:domain :Equipment ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( :ALD_Cycle_Recipe
                                           :Electrical_Qualification_Protocol
                                           :Electrode_Integration_Step
                                           :Measurement
                                           :Post_Deposition_Treatment_Step
                                         )
                           ] ;
                rdfs:label "is equipment for" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#isMaterialUsedBy
:isMaterialUsedBy rdf:type owl:ObjectProperty ;
                  owl:inverseOf :usesMaterial ;
                  rdfs:domain :Material ;
                  rdfs:range [ rdf:type owl:Class ;
                               owl:unionOf ( :ALD_Cycle_Element_Specification
                                             :ALD_Cycle_Recipe
                                             :Electrode_Integration_Step
                                             :Interface_Preparation_Step
                                             :Post_Deposition_Treatment_Step
                                             :Starting_Condition
                                             :Surface_Preclean_Step
                                           )
                             ] ;
                  rdfs:label "is material used by" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#isProcessPartOf
:isProcessPartOf rdf:type owl:ObjectProperty ,
                          owl:TransitiveProperty ;
                 rdfs:domain :Process_Specification ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( :ALD_Film_Formation_Specification
                                            :Electrical_Qualification_Protocol
                                            :Post_Deposition_Integration_Specification
                                            :Predeposition_Preparation
                                          )
                            ] ;
                 rdfs:label "is process part of" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#isResultMeasurementOf
:isResultMeasurementOf rdf:type owl:ObjectProperty ;
                       rdfs:domain :Measurement ;
                       rdfs:range [ rdf:type owl:Class ;
                                    owl:unionOf ( :ALD_Cycle_Recipe
                                                  :Electrical_Qualification_Protocol
                                                  :Electrode_Integration_Step
                                                  :Post_Deposition_Treatment_Step
                                                )
                                  ] ;
                       rdfs:label "is result measurement of" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#isSpecimenOfMeasurement
:isSpecimenOfMeasurement rdf:type owl:ObjectProperty ;
                         rdfs:domain :Film_Material ;
                         rdfs:range :Measurement ;
                         rdfs:label "is specimen of measurement" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#precedes
:precedes rdf:type owl:ObjectProperty ,
                   owl:TransitiveProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :ALD_Cycle_Element_Specification
                                      :Electrical_Qualification_Protocol
                                      :Electrode_Integration_Step
                                      :Interface_Preparation_Step
                                      :Post_Deposition_Treatment_Step
                                      :Surface_Preclean_Step
                                    )
                      ] ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :ALD_Cycle_Element_Specification
                                     :Electrical_Qualification_Protocol
                                     :Electrode_Integration_Step
                                     :Interface_Preparation_Step
                                     :Post_Deposition_Treatment_Step
                                     :Surface_Preclean_Step
                                   )
                     ] ;
          rdfs:label "precedes" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#preparesRecipe
:preparesRecipe rdf:type owl:ObjectProperty ;
                rdfs:domain :Interface_Preparation_Step ;
                rdfs:range :ALD_Cycle_Recipe ;
                rdfs:label "prepares recipe" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#treatsConfiguration
:treatsConfiguration rdf:type owl:ObjectProperty ;
                     rdfs:domain :Post_Deposition_Treatment_Step ;
                     rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( :ALD_Cycle_Recipe
                                                :Electrode_Integration_Step
                                              )
                                ] ;
                     rdfs:label "treats configuration" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#usesEquipment
:usesEquipment rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :ALD_Cycle_Recipe
                                           :Electrical_Qualification_Protocol
                                           :Electrode_Integration_Step
                                           :Measurement
                                           :Post_Deposition_Treatment_Step
                                         )
                           ] ;
               rdfs:range :Equipment ;
               rdfs:label "uses equipment" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#usesMaterial
:usesMaterial rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :ALD_Cycle_Element_Specification
                                          :ALD_Cycle_Recipe
                                          :Electrode_Integration_Step
                                          :Interface_Preparation_Step
                                          :Post_Deposition_Treatment_Step
                                          :Starting_Condition
                                          :Surface_Preclean_Step
                                        )
                          ] ;
              rdfs:range :Material ;
              rdfs:label "uses material" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#usesOxidant
:usesOxidant rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :usesMaterial ;
             rdfs:domain :Co_Reactant_Pulse_Step ;
             rdfs:range :Oxidant ;
             rdfs:label "uses oxidant" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#usesPrecursor
:usesPrecursor rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :usesMaterial ;
               rdfs:domain :Hf_Precursor_Pulse_Step ;
               rdfs:range :Hf_Precursor ;
               rdfs:label "uses precursor" .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasAnnealAmbientText
:hasAnnealAmbientText rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Post_Deposition_Treatment_Step ;
                      rdfs:range xsd:string ;
                      rdfs:label "has anneal ambient text" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasAnnealSequenceText
:hasAnnealSequenceText rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Post_Deposition_Treatment_Step ;
                       rdfs:range xsd:string ;
                       rdfs:label "has anneal sequence text" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasAppliedFieldMVcm
:hasAppliedFieldMVcm rdf:type owl:DatatypeProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :Electrical_Qualification_Protocol
                                                 :Measurement
                                               )
                                 ] ;
                     rdfs:range xsd:decimal ;
                     rdfs:label "has applied field mvcm" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasAppliedVoltageV
:hasAppliedVoltageV rdf:type owl:DatatypeProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :Electrical_Qualification_Protocol
                                                :Measurement
                                              )
                                ] ;
                    rdfs:range xsd:decimal ;
                    rdfs:label "has applied voltage v" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasCapacitorDiameterUm
:hasCapacitorDiameterUm rdf:type owl:DatatypeProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :Electrode_Integration_Step
                                                    :Measurement
                                                    :Starting_Condition
                                                  )
                                    ] ;
                        rdfs:range xsd:decimal ;
                        rdfs:label "has capacitor diameter um" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasCleaningProcedureText
:hasCleaningProcedureText rdf:type owl:DatatypeProperty ;
                          rdfs:domain :Surface_Preclean_Step ;
                          rdfs:range xsd:string ;
                          rdfs:label "has cleaning procedure text" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasCompositionText
:hasCompositionText rdf:type owl:DatatypeProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :Electrode_Integration_Step
                                                :Film_Material
                                                :Interface_Preparation_Step
                                                :Measurement
                                                :Starting_Condition
                                              )
                                ] ;
                    rdfs:range xsd:string ;
                    rdfs:label "has composition text" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasConditionText
:hasConditionText rdf:type owl:DatatypeProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :Equipment
                                              :Material
                                              :Measurement
                                              :Process_Specification
                                            )
                              ] ;
                  rdfs:range xsd:string ;
                  rdfs:label "has condition text" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasCycleStructureText
:hasCycleStructureText rdf:type owl:DatatypeProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( :ALD_Cycle_Recipe
                                                   :Cycle_Repetition_Specification
                                                   :Electrical_Qualification_Protocol
                                                   :Interface_Preparation_Step
                                                   :Post_Deposition_Treatment_Step
                                                 )
                                   ] ;
                       rdfs:range xsd:string ;
                       rdfs:label "has cycle structure text" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasDeliveryLineTemperatureC
:hasDeliveryLineTemperatureC rdf:type owl:DatatypeProperty ;
                             rdfs:domain :Hf_Precursor_Pulse_Step ;
                             rdfs:range xsd:decimal ;
                             rdfs:label "has delivery line temperature c" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasDepositionCycleCount
:hasDepositionCycleCount rdf:type owl:DatatypeProperty ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( :ALD_Cycle_Recipe
                                                     :Cycle_Repetition_Specification
                                                   )
                                     ] ;
                         rdfs:range xsd:nonNegativeInteger ;
                         rdfs:label "has deposition cycle count" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasElectrodeThicknessNm
:hasElectrodeThicknessNm rdf:type owl:DatatypeProperty ;
                         rdfs:domain :Electrode_Integration_Step ;
                         rdfs:range xsd:decimal ;
                         rdfs:label "has electrode thickness nm" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasEnduranceCycleCount
:hasEnduranceCycleCount rdf:type owl:DatatypeProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :Defect_Reliability_Measurement
                                                    :Hysteresis_Reliability_Measurement
                                                  )
                                    ] ;
                        rdfs:range xsd:nonNegativeInteger ;
                        rdfs:label "has endurance cycle count" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasFilmThicknessNm
:hasFilmThicknessNm rdf:type owl:DatatypeProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :ALD_Cycle_Recipe
                                                :Cycle_Repetition_Specification
                                                :Electrode_Integration_Step
                                                :Equipment
                                                :Hf_Precursor_Pulse_Step
                                                :Interface_Preparation_Step
                                                :Measurement
                                                :Starting_Condition
                                              )
                                ] ;
                    rdfs:range xsd:decimal ;
                    rdfs:label "has film thickness nm" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasFrequencyHz
:hasFrequencyHz rdf:type owl:DatatypeProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :Electrical_Qualification_Protocol
                                            :Measurement
                                          )
                            ] ;
                rdfs:range xsd:decimal ;
                rdfs:label "has frequency hz" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasGrowthPerCycleNm
:hasGrowthPerCycleNm rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Thickness_Growth_Measurement ;
                     rdfs:range xsd:decimal ;
                     rdfs:label "has growth per cycle nm" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasIntegrationMethodText
:hasIntegrationMethodText rdf:type owl:DatatypeProperty ;
                          rdfs:domain :Electrode_Integration_Step ;
                          rdfs:range xsd:string ;
                          rdfs:label "has integration method text" .


###  https://w3id.org/opxhs/ald-hfo2-capacitor#hasIntervalTimeS
:hasIntervalTimeS rdf:type owl:DatatypeProperty ;
