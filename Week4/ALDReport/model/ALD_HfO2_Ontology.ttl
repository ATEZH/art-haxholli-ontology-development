@prefix : <https://w3id.org/opxhs/ald-hfo2-capacitor#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/opxhs/ald-hfo2-capacitor> a owl:Ontology ;
    rdfs:label "ALD HfO₂-Based Ferroelectric Capacitor Module" ;
    rdfs:comment "OWL 2 DL ontology for documented ALD HfO₂-based ferroelectric-capacitor process conditions, materials, equipment, measurements, and qualification records." ;
    dcterms:created "2026-08-14"^^xsd:date .

:derivedFrom a owl:AnnotationProperty ;
    rdfs:label "derived from" .

:Process_Specification a owl:Class ;
    rdfs:label "Process Specification" ;
    rdfs:comment "A documented condition, recipe, procedure, step, or protocol within the capacitor module." .

:Starting_Condition a owl:Class ;
    rdfs:label "Starting Condition" ;
    rdfs:comment "An initial film, composition, temperature, thickness, wafer, or device-size condition." ;
    rdfs:subClassOf :Process_Specification .

:Predeposition_Preparation a owl:Class ;
    rdfs:label "Predeposition Preparation" ;
    rdfs:comment "A preparation conducted before ALD film formation." ;
    rdfs:subClassOf :Process_Specification .

:Surface_Preclean_Step a owl:Class ;
    rdfs:label "Surface Preclean Step" ;
    rdfs:comment "A cleaning or exposure-control operation applied before deposition." ;
    rdfs:subClassOf :Predeposition_Preparation .

:Interface_Preparation_Step a owl:Class ;
    rdfs:label "Interface Preparation Step" ;
    rdfs:comment "An interlayer, seed-layer, superlattice-start, or dopant-layer preparation." ;
    rdfs:subClassOf :Predeposition_Preparation,
        [ a owl:Restriction ;
          owl:onProperty :hasInterfaceMaterial ;
          owl:allValuesFrom :Interface_Material
        ] .

:ALD_Film_Formation_Specification a owl:Class ;
    rdfs:label "ALD Film Formation Specification" ;
    rdfs:comment "A specification governing ALD chemistry, timing, temperature, pressure, or repetition." ;
    rdfs:subClassOf :Process_Specification .

:ALD_Cycle_Recipe a owl:Class ;
    rdfs:label "ALD Cycle Recipe" ;
    rdfs:comment "An ALD film-formation specification with an Hf-precursor-pulse part and a co-reactant-pulse part." ;
    rdfs:subClassOf :ALD_Film_Formation_Specification,
        [ a owl:Restriction ;
          owl:onProperty :implementedInReactor ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass :ALD_Reactor
        ] ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :ALD_Film_Formation_Specification
            [ a owl:Restriction ;
              owl:onProperty :hasProcessPart ;
              owl:someValuesFrom :Hf_Precursor_Pulse_Step
            ]
            [ a owl:Restriction ;
              owl:onProperty :hasProcessPart ;
              owl:someValuesFrom :Co_Reactant_Pulse_Step
            ]
            [ a owl:Restriction ;
              owl:onProperty :hasProcessPart ;
              owl:allValuesFrom [
                  a owl:Class ;
                  owl:unionOf (
                      :Hf_Precursor_Pulse_Step
                      :First_Purge_Step
                      :Co_Reactant_Pulse_Step
                      :Second_Purge_Step
                      :Cycle_Repetition_Specification
                  )
              ]
            ]
        )
    ] .

:ALD_Cycle_Element_Specification a owl:Class ;
    rdfs:label "ALD Cycle Element Specification" ;
    rdfs:comment "A specification of one position within an ALD cycle." ;
    rdfs:subClassOf :ALD_Film_Formation_Specification .

:Hf_Precursor_Pulse_Step a owl:Class ;
    rdfs:label "Hf Precursor Pulse Step" ;
    rdfs:comment "The first half-cycle delivering an Hf precursor under route-specific conditions." ;
    rdfs:subClassOf :ALD_Cycle_Element_Specification,
        [ a owl:Restriction ;
          owl:onProperty :usesPrecursor ;
          owl:allValuesFrom :Hf_Precursor
        ] .

:First_Purge_Step a owl:Class ;
    rdfs:label "First Purge Step" ;
    rdfs:comment "A cycle element directly after an Hf-precursor pulse and directly before the paired co-reactant pulse." ;
    rdfs:subClassOf :ALD_Cycle_Element_Specification ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :ALD_Cycle_Element_Specification
            [ a owl:Restriction ;
              owl:onProperty :directlyFollows ;
              owl:someValuesFrom :Hf_Precursor_Pulse_Step
            ]
            [ a owl:Restriction ;
              owl:onProperty :directlyPrecedes ;
              owl:someValuesFrom :Co_Reactant_Pulse_Step
            ]
        )
    ] .

:Co_Reactant_Pulse_Step a owl:Class ;
    rdfs:label "Co Reactant Pulse Step" ;
    rdfs:comment "An oxidant or plasma exposure paired with a metal or dopant subcycle." ;
    rdfs:subClassOf :ALD_Cycle_Element_Specification,
        [ a owl:Restriction ;
          owl:onProperty :usesOxidant ;
          owl:allValuesFrom :Oxidant
        ] .

:Second_Purge_Step a owl:Class ;
    rdfs:label "Second Purge Step" ;
    rdfs:comment "A purge following a co-reactant exposure." ;
    rdfs:subClassOf :ALD_Cycle_Element_Specification .

:Cycle_Repetition_Specification a owl:Class ;
    rdfs:label "Cycle Repetition Specification" ;
    rdfs:comment "A supercycle count, block size, ratio, or repeated-half-cycle architecture." ;
    rdfs:subClassOf :ALD_Film_Formation_Specification .

:Post_Deposition_Integration_Specification a owl:Class ;
    rdfs:label "Post Deposition Integration Specification" ;
    rdfs:comment "A specification for stack processing after film deposition." ;
    rdfs:subClassOf :Process_Specification .

:Post_Deposition_Treatment_Step a owl:Class ;
    rdfs:label "Post Deposition Treatment Step" ;
    rdfs:comment "An anneal, plasma treatment, or related operation identified together with stack state." ;
    rdfs:subClassOf :Post_Deposition_Integration_Specification .

:Electrode_Integration_Step a owl:Class ;
    rdfs:label "Electrode Integration Step" ;
    rdfs:comment "A position-specific electrode, cap, contact, or hard-mask integration operation." ;
    rdfs:subClassOf :Post_Deposition_Integration_Specification,
        [ a owl:Restriction ;
          owl:onProperty :hasElectrodeMaterial ;
          owl:allValuesFrom :Electrode_Material
        ] .

:Electrical_Qualification_Protocol a owl:Class ;
    rdfs:label "Electrical Qualification Protocol" ;
    rdfs:comment "A conditioning, stressing, cycling, or readout protocol with waveform and electrode setup." ;
    rdfs:subClassOf :Process_Specification .

:Material a owl:Class ;
    rdfs:label "Material" ;
    rdfs:comment "A substance participating in the documented module flow." .

:Film_Material a owl:Class ;
    rdfs:label "Film Material" ;
    rdfs:comment "An HfO2-based film or reported composite film family." ;
    rdfs:subClassOf :Material .

:Hf_Precursor a owl:Class ;
    rdfs:label "Hf Precursor" ;
    rdfs:comment "An Hf-bearing chemical precursor used in a deposition half-cycle." ;
    rdfs:subClassOf :Material .

:Oxidant a owl:Class ;
    rdfs:label "Oxidant" ;
    rdfs:comment "Water, ozone, oxygen plasma, or another reported oxidizing co-reactant." ;
    rdfs:subClassOf :Material .

:Electrode_Material a owl:Class ;
    rdfs:label "Electrode Material" ;
    rdfs:comment "A material serving as a bottom electrode, top electrode, cap, or electrical contact." ;
    rdfs:subClassOf :Material .

:Interface_Material a owl:Class ;
    rdfs:label "Interface Material" ;
    rdfs:comment "A seed layer, interlayer, insertion layer, or interface-localized material." ;
    rdfs:subClassOf :Material .

:Equipment a owl:Class ;
    rdfs:label "Equipment" ;
    rdfs:comment "A tool, reactor, instrument, or explicitly reported equipment chain." .

:Deposition_Tool a owl:Class ;
    rdfs:label "Deposition Tool" ;
    rdfs:comment "Equipment used for oxide or electrode deposition." ;
    rdfs:subClassOf :Equipment .

:ALD_Reactor a owl:Class ;
    rdfs:label "ALD Reactor" ;
    rdfs:comment "A reactor platform used for ALD or PEALD growth." ;
    rdfs:subClassOf :Deposition_Tool .

:Thermal_ALD_Reactor a owl:Class ;
    rdfs:label "Thermal ALD Reactor" ;
    rdfs:comment "An ALD reactor used in a reported thermal-ALD configuration." ;
    rdfs:subClassOf :ALD_Reactor .

:PEALD_Reactor a owl:Class ;
    rdfs:label "PEALD Reactor" ;
    rdfs:comment "An ALD reactor used in a reported plasma-enhanced configuration." ;
    rdfs:subClassOf :ALD_Reactor .

:Electrode_Deposition_Tool a owl:Class ;
    rdfs:label "Electrode Deposition Tool" ;
    rdfs:comment "Sputtering, PVD, evaporation, or equivalent electrode-deposition equipment." ;
    rdfs:subClassOf :Deposition_Tool .

:Thermal_Tool a owl:Class ;
    rdfs:label "Thermal Tool" ;
    rdfs:comment "Equipment used for RTA, RTP, or furnace treatment." ;
    rdfs:subClassOf :Equipment .

:Metrology_Tool a owl:Class ;
    rdfs:label "Metrology Tool" ;
    rdfs:comment "Structural, chemical, thickness, or microscopy instrumentation." ;
    rdfs:subClassOf :Equipment .

:Electrical_Test_Tool a owl:Class ;
    rdfs:label "Electrical Test Tool" ;
    rdfs:comment "Equipment used for ferroelectric, current, breakdown, or parameter measurement." ;
    rdfs:subClassOf :Equipment .

:Measurement a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:comment "A context-bound n-ary record of a measured or qualified output, method, specimen, conditions, and limitations." ;
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty :hasSpecimenMaterial ;
          owl:allValuesFrom :Film_Material
        ],
        [ a owl:Restriction ;
          owl:onProperty :hasUnit ;
          owl:allValuesFrom xsd:string
        ] .

:Thickness_Growth_Measurement a owl:Class ;
    rdfs:label "Thickness Growth Measurement" ;
    rdfs:comment "A film-thickness or growth-per-cycle result retaining chemistry and temperature context." ;
    rdfs:subClassOf :Measurement .

:Conformality_Uniformity_Measurement a owl:Class ;
    rdfs:label "Conformality Uniformity Measurement" ;
    rdfs:comment "A step-coverage, spatial-uniformity, or nonuniformity result." ;
    rdfs:subClassOf :Measurement .

:Polarisation_Coercive_Measurement a owl:Class ;
    rdfs:label "Polarisation Coercive Measurement" ;
    rdfs:comment "A polarization, switched-charge, coercive-field, or coercive-voltage result." ;
    rdfs:subClassOf :Measurement .

:Leakage_Current_Measurement a owl:Class ;
    rdfs:label "Leakage Current Measurement" ;
    rdfs:comment "A leakage-current result under stated bias and conditioning." ;
    rdfs:subClassOf :Measurement .

:Defect_Reliability_Measurement a owl:Class ;
    rdfs:label "Defect Reliability Measurement" ;
    rdfs:comment "A vacancy, endurance, fatigue, retention, or breakdown-limited reliability result." ;
    rdfs:subClassOf :Measurement .

:Crystalline_Phase_Measurement a owl:Class ;
    rdfs:label "Crystalline Phase Measurement" ;
    rdfs:comment "A phase-sensitive structural output without a phase taxonomy." ;
    rdfs:subClassOf :Measurement .

:Film_Thickness_Uniformity_Measurement a owl:Class ;
    rdfs:label "Film Thickness Uniformity Measurement" ;
    rdfs:comment "A thickness or spatial-thickness output with sampling context." ;
    rdfs:subClassOf :Measurement .

:Interface_Defect_Measurement a owl:Class ;
    rdfs:label "Interface Defect Measurement" ;
    rdfs:comment "An interface morphology, composition, impurity, or depth-profile output." ;
    rdfs:subClassOf :Measurement .

:Leakage_Breakdown_Measurement a owl:Class ;
    rdfs:label "Leakage Breakdown Measurement" ;
    rdfs:comment "A sweep, spatial-leakage, or time-zero-breakdown output." ;
    rdfs:subClassOf :Measurement .

:Hysteresis_Reliability_Measurement a owl:Class ;
    rdfs:label "Hysteresis Reliability Measurement" ;
    rdfs:comment "A hysteresis, PUND, switching, wake-up, fatigue, cycling, or retention output." ;
    rdfs:subClassOf :Measurement .

[] a owl:AllDisjointClasses ;
    owl:members ( :Process_Specification :Material :Equipment :Measurement ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Hf_Precursor_Pulse_Step :First_Purge_Step :Co_Reactant_Pulse_Step :Second_Purge_Step ) .

:hasProcessPart a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "has process part" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( :Predeposition_Preparation :ALD_Film_Formation_Specification :Post_Deposition_Integration_Specification :Electrical_Qualification_Protocol )
    ] ;
    rdfs:range :Process_Specification ;
    owl:inverseOf :isProcessPartOf .

:isProcessPartOf a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "is process part of" ;
    rdfs:domain :Process_Specification ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( :Predeposition_Preparation :ALD_Film_Formation_Specification :Post_Deposition_Integration_Specification :Electrical_Qualification_Protocol )
    ] ;
    owl:inverseOf :hasProcessPart .

:precedes a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "precedes" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( :Surface_Preclean_Step :Interface_Preparation_Step :ALD_Cycle_Element_Specification :Post_Deposition_Treatment_Step :Electrode_Integration_Step :Electrical_Qualification_Protocol )
    ] ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( :Surface_Preclean_Step :Interface_Preparation_Step :ALD_Cycle_Element_Specification :Post_Deposition_Treatment_Step :Electrode_Integration_Step :Electrical_Qualification_Protocol )
    ] ;
    owl:inverseOf :follows .

:follows a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "follows" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( :Surface_Preclean_Step :Interface_Preparation_Step :ALD_Cycle_Element_Specification :Post_Deposition_Treatment_Step :Electrode_Integration_Step :Electrical_Qualification_Protocol )
    ] ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( :Surface_Preclean_Step :Interface_Preparation_Step :ALD_Cycle_Element_Specification :Post_Deposition_Treatment_Step :Electrode_Integration_Step :Electrical_Qualification_Protocol )
    ] ;
    owl:inverseOf :precedes .

:directlyPrecedes a owl:ObjectProperty, owl:AsymmetricProperty, owl:IrreflexiveProperty ;
    rdfs:label "directly precedes" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( :Surface_Preclean_Step :Interface_Preparation_Step :ALD_Cycle_Element_Specification :Post_Deposition_Treatment_Step :Electrode_Integration_Step :Electrical_Qualification_Protocol )
    ] ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( :Surface_Preclean_Step :Interface_Preparation_Step :ALD_Cycle_Element_Specification :Post_Deposition_Treatment_Step :Electrode_Integration_Step :Electrical_Qualification_Protocol )
    ] ;
    rdfs:subPropertyOf :precedes ;
    owl:inverseOf :directlyFollows .

:directlyFollows a owl:ObjectProperty, owl:AsymmetricProperty, owl:IrreflexiveProperty ;
    rdfs:label "directly follows" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( :Surface_Preclean_Step :Interface_Preparation_Step :ALD_Cycle_Element_Specification :Post_Deposition_Treatment_Step :Electrode_Integration_Step :Electrical_Qualification_Protocol )
    ] ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( :Surface_Preclean_Step :Interface_Preparation_Step :ALD_Cycle_Element_Specification :Post_Deposition_Treatment_Step :Electrode_Integration_Step :Electrical_Qualification_Protocol )
    ] ;
    rdfs:subPropertyOf :follows ;
    owl:inverseOf :directlyPrecedes .

:hasStartingCondition a owl:ObjectProperty ;
    rdfs:label "has starting condition" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( :Predeposition_Preparation :ALD_Film_Formation_Specification :Post_Deposition_Integration_Specification :Electrical_Qualification_Protocol )
    ] ;
    rdfs:range :Starting_Condition ;
    owl:inverseOf :conditionsProcess .

:conditionsProcess a owl:ObjectProperty ;
    rdfs:label "conditions process" ;
    rdfs:domain :Starting_Condition ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( :Predeposition_Preparation :ALD_Film_Formation_Specification :Post_Deposition_Integration_Specification :Electrical_Qualification_Protocol )
    ] ;
    owl:inverseOf :hasStartingCondition .

:usesMaterial a owl:ObjectProperty ;
    rdfs:label "uses material" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( :Starting_Condition :Surface_Preclean_Step :Interface_Preparation_Step :ALD_Cycle_Recipe :ALD_Cycle_Element_Specification :Post_Deposition_Treatment_Step :Electrode_Integration_Step )
    ] ;
    rdfs:range :Material ;
    owl:inverseOf :isMaterialUsedBy .

:isMaterialUsedBy a owl:ObjectProperty ;
    rdfs:label "is material used by" ;
    rdfs:domain :Material ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( :Starting_Condition :Surface_Preclean_Step :Interface_Preparation_Step :ALD_Cycle_Recipe :ALD_Cycle_Element_Specification :Post_Deposition_Treatment_Step :Electrode_Integration_Step )
    ] ;
    owl:inverseOf :usesMaterial .

:usesPrecursor a owl:ObjectProperty ;
    rdfs:label "uses precursor" ;
    rdfs:domain :Hf_Precursor_Pulse_Step ;
    rdfs:range :Hf_Precursor ;
    rdfs:subPropertyOf :usesMaterial .

:usesOxidant a owl:ObjectProperty ;
    rdfs:label "uses oxidant" ;
    rdfs:domain :Co_Reactant_Pulse_Step ;
    rdfs:range :Oxidant ;
    rdfs:subPropertyOf :usesMaterial .

:hasInterfaceMaterial a owl:ObjectProperty ;
    rdfs:label "has interface material" ;
    rdfs:domain :Interface_Preparation_Step ;
    rdfs:range :Interface_Material ;
    rdfs:subPropertyOf :usesMaterial .

:hasElectrodeMaterial a owl:ObjectProperty ;
    rdfs:label "has electrode material" ;
    rdfs:domain :Electrode_Integration_Step ;
    rdfs:range :Electrode_Material ;
    rdfs:subPropertyOf :usesMaterial .

:hasFilmMaterial a owl:ObjectProperty ;
    rdfs:label "has film material" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( :Starting_Condition :ALD_Cycle_Recipe :Post_Deposition_Treatment_Step :Electrode_Integration_Step :Measurement )
    ] ;
    rdfs:range :Film_Material .

:usesEquipment a owl:ObjectProperty ;
    rdfs:label "uses equipment" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( :ALD_Cycle_Recipe :Post_Deposition_Treatment_Step :Electrode_Integration_Step :Electrical_Qualification_Protocol :Measurement )
    ] ;
    rdfs:range :Equipment ;
    owl:inverseOf :isEquipmentFor .

:isEquipmentFor a owl:ObjectProperty ;
    rdfs:label "is equipment for" ;
    rdfs:domain :Equipment ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( :ALD_Cycle_Recipe :Post_Deposition_Treatment_Step :Electrode_Integration_Step :Electrical_Qualification_Protocol :Measurement )
    ] ;
    owl:inverseOf :usesEquipment .

:implementedInReactor a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "implemented in reactor" ;
    rdfs:domain :ALD_Cycle_Recipe ;
    rdfs:range :ALD_Reactor ;
    owl:inverseOf :hostsRecipe .

:hostsRecipe a owl:ObjectProperty ;
    rdfs:label "hosts recipe" ;
    rdfs:domain :ALD_Reactor ;
    rdfs:range :ALD_Cycle_Recipe ;
    owl:inverseOf :implementedInReactor .

:hasInterfacePreparation a owl:ObjectProperty ;
    rdfs:label "has interface preparation" ;
    rdfs:domain :ALD_Cycle_Recipe ;
    rdfs:range :Interface_Preparation_Step ;
    owl:inverseOf :preparesRecipe .

:preparesRecipe a owl:ObjectProperty ;
    rdfs:label "prepares recipe" ;
    rdfs:domain :Interface_Preparation_Step ;
    rdfs:range :ALD_Cycle_Recipe ;
    owl:inverseOf :hasInterfacePreparation .

:hasPostDepositionTreatment a owl:ObjectProperty ;
    rdfs:label "has post deposition treatment" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( :ALD_Cycle_Recipe :Electrode_Integration_Step )
    ] ;
    rdfs:range :Post_Deposition_Treatment_Step ;
    owl:inverseOf :treatsConfiguration .

:treatsConfiguration a owl:ObjectProperty ;
    rdfs:label "treats configuration" ;
    rdfs:domain :Post_Deposition_Treatment_Step ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( :ALD_Cycle_Recipe :Electrode_Integration_Step )
    ] ;
    owl:inverseOf :hasPostDepositionTreatment .

:hasElectrodeIntegration a owl:ObjectProperty ;
    rdfs:label "has electrode integration" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( :ALD_Cycle_Recipe :Post_Deposition_Treatment_Step )
    ] ;
    rdfs:range :Electrode_Integration_Step ;
    owl:inverseOf :integratesConfiguration .

:integratesConfiguration a owl:ObjectProperty ;
    rdfs:label "integrates configuration" ;
    rdfs:domain :Electrode_Integration_Step ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( :ALD_Cycle_Recipe :Post_Deposition_Treatment_Step )
    ] ;
    owl:inverseOf :hasElectrodeIntegration .

:hasResultMeasurement a owl:ObjectProperty ;
    rdfs:label "has result measurement" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( :ALD_Cycle_Recipe :Post_Deposition_Treatment_Step :Electrode_Integration_Step :Electrical_Qualification_Protocol )
    ] ;
    rdfs:range :Measurement ;
    owl:inverseOf :isResultMeasurementOf .

:isResultMeasurementOf a owl:ObjectProperty ;
    rdfs:label "is result measurement of" ;
    rdfs:domain :Measurement ;
    rdfs:range [ a owl:Class ;
        owl:unionOf ( :ALD_Cycle_Recipe :Post_Deposition_Treatment_Step :Electrode_Integration_Step :Electrical_Qualification_Protocol )
    ] ;
    owl:inverseOf :hasResultMeasurement .

:hasSpecimenMaterial a owl:ObjectProperty ;
    rdfs:label "has specimen material" ;
    rdfs:domain :Measurement ;
    rdfs:range :Film_Material ;
    owl:inverseOf :isSpecimenOfMeasurement .

:isSpecimenOfMeasurement a owl:ObjectProperty ;
    rdfs:label "is specimen of measurement" ;
    rdfs:domain :Film_Material ;
    rdfs:range :Measurement ;
    owl:inverseOf :hasSpecimenMaterial .

:hasMaterialDesignation a owl:DatatypeProperty ;
    rdfs:label "has material designation" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Process_Specification :Equipment ) ] ;
    rdfs:range xsd:string .

:hasCompositionText a owl:DatatypeProperty ;
    rdfs:label "has composition text" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Starting_Condition :Interface_Preparation_Step :Electrode_Integration_Step :Film_Material :Measurement ) ] ;
    rdfs:range xsd:string .

:hasCleaningProcedureText a owl:DatatypeProperty ;
    rdfs:label "has cleaning procedure text" ;
    rdfs:domain :Surface_Preclean_Step ;
    rdfs:range xsd:string .

:hasSeedPlacementText a owl:DatatypeProperty ;
    rdfs:label "has seed placement text" ;
    rdfs:domain :Interface_Preparation_Step ;
    rdfs:range xsd:string .

:hasIntegrationMethodText a owl:DatatypeProperty ;
    rdfs:label "has integration method text" ;
    rdfs:domain :Electrode_Integration_Step ;
    rdfs:range xsd:string .

:hasAnnealSequenceText a owl:DatatypeProperty ;
    rdfs:label "has anneal sequence text" ;
    rdfs:domain :Post_Deposition_Treatment_Step ;
    rdfs:range xsd:string .

:hasAnnealAmbientText a owl:DatatypeProperty ;
    rdfs:label "has anneal ambient text" ;
    rdfs:domain :Post_Deposition_Treatment_Step ;
    rdfs:range xsd:string .

:hasCycleStructureText a owl:DatatypeProperty ;
    rdfs:label "has cycle structure text" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :ALD_Cycle_Recipe :Cycle_Repetition_Specification :Interface_Preparation_Step :Post_Deposition_Treatment_Step :Electrical_Qualification_Protocol ) ] ;
    rdfs:range xsd:string .

:hasReactorTypeText a owl:DatatypeProperty ;
    rdfs:label "has reactor type text" ;
    rdfs:domain :ALD_Reactor ;
    rdfs:range xsd:string .

:hasToolNameText a owl:DatatypeProperty ;
    rdfs:label "has tool name text" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Equipment :Co_Reactant_Pulse_Step :Measurement ) ] ;
    rdfs:range xsd:string .

:hasMetrologyTechniqueName a owl:DatatypeProperty ;
    rdfs:label "has metrology technique name" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Equipment :Measurement ) ] ;
    rdfs:range xsd:string .

:hasSpecimenDescription a owl:DatatypeProperty ;
    rdfs:label "has specimen description" ;
    rdfs:domain :Measurement ;
    rdfs:range xsd:string .

:hasConditionText a owl:DatatypeProperty ;
