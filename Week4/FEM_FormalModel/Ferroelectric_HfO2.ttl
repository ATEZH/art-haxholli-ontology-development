                        rdfs:label "LowCarbonContamination" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#M_B1_Trap_Density_cycled
:M_B1_Trap_Density_cycled rdf:type owl:NamedIndividual ,
                                   :Measurement ;
                          :measuredOn :Artifact_B1_FeFET_cycled ;
                          :measurementMethod :QSCV ;
                          :measuresProperty :trapped_charge_density ;
                          :hasMeasuredValue "3.6E14"^^xsd:double ;
                          :hasUnit "cm-2" ;
                          :epistemicStatus "verified" ;
                          :sourceLocator "S10{III D}" ;
                          rdfs:comment "Two separate instances, not one value overwritten. This pair is why trap density cannot be a data property on Material." .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#M_B1_Trap_Density_initial
:M_B1_Trap_Density_initial rdf:type owl:NamedIndividual ,
                                    :Measurement ;
                           :measuredOn :Artifact_B1_FeFET_L5_W150 ;
                           :measurementMethod :QSCV ;
                           :measuresProperty :trapped_charge_density ;
                           :hasMeasuredValue "1.0E14"^^xsd:double ;
                           :hasUnit "cm-2" ;
                           :epistemicStatus "verified" ;
                           :sourceLocator "S10{III D}" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#M_B1_Vth
:M_B1_Vth rdf:type owl:NamedIndividual ,
                   :Measurement ;
          :measuredOn :Artifact_B1_FeFET_L5_W150 ;
          :measurementMethod :IdVg_Transfer ;
          :measuresProperty :threshold_voltage_Vth ;
          :hasVthConvention "linear_extrapolation" ;
          :epistemicStatus "verified" ;
          :sourceLocator "S10{II A}" ;
          rdfs:comment "S10 defines Vth by linear extrapolation; S11 by constant current on a near-identical stack. Recording the convention is one field and it closes the trap permanently." .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#M_E_Ru_Endurance
:M_E_Ru_Endurance rdf:type owl:NamedIndividual ,
                           :Measurement ;
                  :measuredOn :Artifact_E_Ru_Capacitor ;
                  :measurementMethod :Endurance_Cycling ;
                  :measuresProperty :endurance_cycles ;
                  :hasAppliedVoltage_V "3.0"^^xsd:double ;
                  :hasEnduranceCycleCount "10000000000"^^xsd:long ;
                  :hasPulseWidth_s "3.0E-6"^^xsd:double ;
                  :epistemicStatus "verified" ;
                  :sourceLocator "S24{3.2}" ;
                  rdfs:comment "Survives 1e10 under identical conditions to the TiN device. The pair is the whole argument for reifying Measurement." .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#M_E_TiN_Endurance
