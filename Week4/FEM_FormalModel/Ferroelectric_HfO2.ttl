###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#A1_Substrate_Clean
:A1_Substrate_Clean rdf:type owl:NamedIndividual ,
                             :Wet_Clean ;
                    :belongsToFlow :FlowA_LabMFM ;
                    :directlyPrecedes :A2_BE_Sputter ;
                    :hasInput :Si_substrate ;
                    :precedes :A2_BE_Sputter ,
                              :A3_FE_Deposition ,
                              :A4_TE_Capping ,
                              :A5_Crystallisation_Anneal ,
                              :A6_Patterned_Metal_Deposition ,
                              :A7_SC1_Etch ;
                    :hasStepIndex "1"^^xsd:int ;
                    :epistemicStatus "verified" ;
                    :sourceLocator "S1" ;
                    rdfs:label "A1_Substrate_Clean" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#A2_BE_Sputter
