###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#A5_Crystallisation_Anneal
:A5_Crystallisation_Anneal rdf:type owl:NamedIndividual ,
                                    :Crystallisation_Anneal ;
                           :belongsToFlow :FlowA_LabMFM ;
                           :directlyPrecedes :A6_Patterned_Metal_Deposition ;
                           :precedes :A6_Patterned_Metal_Deposition ,
                                     :A7_SC1_Etch ;
                           :transformsPhase :Orthorhombic_Pca21 ;
                           :hasStepIndex "5"^^xsd:int ;
                           :epistemicStatus "verified" ;
                           :sourceLocator "S1{II} + Tables I, III, V" ;
                           rdfs:comment "No temperature or duration value. S1's body gives 400-1000 C and 1-60 s while its tables give 1 s to 20 min. Empty because the source is inconsistent, not because the answer is zero." ;
                           rdfs:label "A5_Crystallisation_Anneal" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#A6_Patterned_Metal_Deposition
:A6_Patterned_Metal_Deposition rdf:type owl:NamedIndividual ,
                                        :Deposition ;
                               :belongsToFlow :FlowA_LabMFM ;
                               :depositsMaterial :Ti_Pt_contact ;
                               :directlyPrecedes :A7_SC1_Etch ;
                               :precedes :A7_SC1_Etch ;
                               :hasStepIndex "6"^^xsd:int ;
                               :contradictedBy "S1" ;
                               :epistemicStatus "verified" ;
                               :sourceLocator "S1{II} vs Fig. 3 caption" ;
                               rdfs:comment "S1's body text says step 5 is metal electrode deposition; the Figure 3 caption says step 5 is electrode patterning. Both locators are kept and neither is picked as the true version." ;
                               rdfs:label "A6_Patterned_Metal_Deposition" .


