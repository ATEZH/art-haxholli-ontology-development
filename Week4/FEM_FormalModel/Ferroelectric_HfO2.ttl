@prefix : <http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#> .

<http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2> rdf:type owl:Ontology ;
                                                                       owl:versionIRI <http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2/v3> ;
                                                                       rdfs:comment "Ferroelectric HfO2 memory ontology." .

#################################################################
#    Annotation properties
#################################################################

###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#contradictedBy
:contradictedBy rdf:type owl:AnnotationProperty ;
                rdfs:comment "Marks an entity whose own source contradicts itself, naming the source." .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#epistemicStatus
:epistemicStatus rdf:type owl:AnnotationProperty ;
                 rdfs:comment "One of: verified, uncertain, inferred, scaffolding, named_only. Formalises the UNCERTAIN and INFERRED markers and the untagged-scaffolding rule from the specification front matter." .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#scopeNote
:scopeNote rdf:type owl:AnnotationProperty ;
           rdfs:comment "Records what a class deliberately excludes." .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#sourceLocator
:sourceLocator rdf:type owl:AnnotationProperty ;
               rdfs:comment "The per-entity source tag, e.g. S1{II A 2} meaning source S1, section II A 2. Repeatable: an entity may be attested by several sources." .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#uncertaintyRef
:uncertaintyRef rdf:type owl:AnnotationProperty ;
                rdfs:comment "Points an entity at its entry in the uncertainty register, e.g. U13." .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#arrangedAs
:arrangedAs rdf:type owl:ObjectProperty ;
            rdfs:domain :Memory_Cell_Architecture ;
            rdfs:range :Array_Architecture ;
            :epistemicStatus "scaffolding" ;
            rdfs:label "arrangedAs" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#belongsToFlow
:belongsToFlow rdf:type owl:ObjectProperty ;
               rdfs:domain :Unit_Process ;
               rdfs:range :Process_Flow ;
               :epistemicStatus "scaffolding" ;
               rdfs:comment "Required on every Unit_Process individual. Without it, precedes produces contradictions between Flow C and the rest." ;
               rdfs:label "belongsToFlow" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#constrainsMaterialChoice
:constrainsMaterialChoice rdf:type owl:ObjectProperty ;
                          rdfs:domain :Capability ;
                          rdfs:range :Material ;
                          :epistemicStatus "uncertain" ;
                          :sourceLocator "S24{1}" ;
                          rdfs:comment "Ru selected partly because a dry plasma etch selective to HfO2 exists for it: stated as a motivation, not a demonstrated constraint." ;
                          rdfs:label "constrainsMaterialChoice" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#depositsMaterial
:depositsMaterial rdf:type owl:ObjectProperty ;
                  rdfs:domain :Deposition ;
                  rdfs:range :Material ;
                  :epistemicStatus "scaffolding" ;
                  rdfs:label "depositsMaterial" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#destabilisesPhase
:destabilisesPhase rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :Defect
                                               :Material
                                             )
                               ] ;
                   rdfs:range :Phase_State ;
                   :epistemicStatus "verified" ;
                   :sourceLocator "S1{II A 2}" ;
                   rdfs:label "destabilisesPhase" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#diffusesInto
:diffusesInto rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Dopant
                                          :Material
                                        )
                          ] ;
              rdfs:range :Material ;
              :epistemicStatus "verified" ;
              :sourceLocator "S9{p.5}" ;
              rdfs:comment "Zr4 diffuses into SiON, degrading the interfacial layer." ;
              rdfs:label "diffusesInto" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#directlyPrecedes
:directlyPrecedes rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :precedes ;
                  rdf:type owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain :Unit_Process ;
                  rdfs:range :Unit_Process ;
                  :epistemicStatus "scaffolding" ;
                  rdfs:comment "Immediate ordering within one flow. Deliberately NOT transitive; precedes is the transitive property." ;
                  rdfs:label "directlyPrecedes" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#enables
:enables rdf:type owl:ObjectProperty ;
         rdfs:domain :Capability ;
         rdfs:range [ rdf:type owl:Class ;
                      owl:unionOf ( :Array_Architecture
                                    :Memory_Cell_Architecture
                                  )
                    ] ;
         :epistemicStatus "verified" ;
         :sourceLocator "S1{II B}" ;
         rdfs:label "enables" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#etchesMaterial
:etchesMaterial rdf:type owl:ObjectProperty ;
                rdfs:domain :Etch ;
                rdfs:range :Material ;
                :epistemicStatus "verified" ;
                :sourceLocator "S24{2}" ;
                rdfs:label "etchesMaterial" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#exhibits
:exhibits rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Array_Architecture
                                      :Layer_Stack
                                      :Memory_Cell_Architecture
                                    )
                      ] ;
          rdfs:range :Degradation_Phenomenon ;
          :epistemicStatus "scaffolding" ;
          rdfs:comment "Domain includes Array_Architecture: Pass_Disturb is a 3D NAND string phenomenon and had no possible subject before." ;
          rdfs:label "exhibits" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#flowProducesArchitecture
:flowProducesArchitecture rdf:type owl:ObjectProperty ;
                          rdfs:domain :Process_Flow ;
                          rdfs:range [ rdf:type owl:Class ;
                                       owl:unionOf ( :Layer_Stack
                                                     :Memory_Cell_Architecture
                                                   )
                                     ] ;
                          :epistemicStatus "scaffolding" ;
                          rdfs:comment "Flow C produces FeRAM_1T1C; Flow E produces MFM; Flow B1 produces MFIS." ;
                          rdfs:label "flowProducesArchitecture" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#flowTargetsNode
:flowTargetsNode rdf:type owl:ObjectProperty ;
                 rdfs:domain :Process_Flow ;
                 rdfs:range :Technology_Node ;
                 :epistemicStatus "verified" ;
                 :sourceLocator "S12a{P4}" ;
                 rdfs:comment "Flow C targets 130 nm." ;
                 rdfs:label "flowTargetsNode" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasAmbient
:hasAmbient rdf:type owl:ObjectProperty ;
            rdfs:domain :Thermal_Process ;
            rdfs:range :Process_Gas ;
            :epistemicStatus "verified" ;
            :sourceLocator "S1{II B 2}" ;
            rdfs:comment "N2 recommended over O2." ;
            rdfs:label "hasAmbient" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasBottomElectrode
:hasBottomElectrode rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :hasElectrode ;
                    rdfs:domain :Layer_Stack ;
                    rdfs:range :Electrode_Material ;
                    :epistemicStatus "inferred" ;
                    rdfs:comment "Derived. rdfs:subPropertyOf hasElectrode." ;
                    rdfs:label "hasBottomElectrode" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasChannel
:hasChannel rdf:type owl:ObjectProperty ;
            rdfs:domain :Memory_Cell_Architecture ;
            rdfs:range :Channel_Material ;
            :epistemicStatus "scaffolding" ;
            rdfs:label "hasChannel" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasDopant
:hasDopant rdf:type owl:ObjectProperty ;
           rdfs:domain :Ferroelectric_Material ;
           rdfs:range :Dopant ;
           :epistemicStatus "scaffolding" ;
           rdfs:label "hasDopant" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasElectrode
:hasElectrode rdf:type owl:ObjectProperty ;
              rdfs:domain :Layer_Stack ;
              rdfs:range :Electrode_Material ;
              :epistemicStatus "inferred" ;
              rdfs:comment "DERIVED, not asserted by hand. Shortcut for the material of a slot whose slotRole is an electrode role. The slot is authoritative." ;
              rdfs:label "hasElectrode" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasFerroelectricLayer
:hasFerroelectricLayer rdf:type owl:ObjectProperty ;
                       rdfs:domain :Layer_Stack ;
                       rdfs:range :Ferroelectric_Material ;
                       :epistemicStatus "inferred" ;
                       rdfs:comment "Derived, from slotRole = ferroelectric_layer." ;
                       rdfs:label "hasFerroelectricLayer" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasInput
:hasInput rdf:type owl:ObjectProperty ;
          rdfs:domain :Unit_Process ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :Artifact
                                     :Material
                                   )
                     ] ;
          :epistemicStatus "scaffolding" ;
          rdfs:label "hasInput" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasInterfacialLayer
:hasInterfacialLayer rdf:type owl:ObjectProperty ;
                     rdfs:domain :Layer_Stack ;
                     rdfs:range :Interfacial_Layer_Material ;
                     :epistemicStatus "inferred" ;
                     rdfs:comment "Derived, from slotRole = interfacial_layer." ;
                     rdfs:label "hasInterfacialLayer" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasMeasurement
:hasMeasurement rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :Artifact
                                            :Layer_Stack
                                            :Memory_Cell_Architecture
                                          )
                            ] ;
                rdfs:range :Measurement ;
                :epistemicStatus "scaffolding" ;
                rdfs:label "hasMeasurement" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasOutput
:hasOutput rdf:type owl:ObjectProperty ;
           rdfs:domain :Unit_Process ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :Artifact
                                      :Material
                                    )
                      ] ;
           :epistemicStatus "scaffolding" ;
           rdfs:label "hasOutput" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasPhase
:hasPhase rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Layer_Stack
                                      :Material
                                    )
                      ] ;
          rdfs:range :Phase_State ;
          :epistemicStatus "uncertain" ;
          :sourceLocator "S27{Fig. 1a}" ;
          rdfs:comment "Films are phase mixtures, so this is a simplification. Non-functional, and absence of a phase assertion never denies the phase. A quantified fraction is a Measurement." ;
          rdfs:label "hasPhase" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasSlot
:hasSlot rdf:type owl:ObjectProperty ;
         rdfs:domain :Layer_Stack ;
         rdfs:range :Layer_Slot ;
         :epistemicStatus "inferred" ;
         rdfs:comment "Ordered via the slot's layerIndex. Replaces the earlier hasLayer / hasLayerAtPosition pair." ;
         rdfs:label "hasSlot" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasTopElectrode
:hasTopElectrode rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasElectrode ;
                 rdfs:domain :Layer_Stack ;
                 rdfs:range :Electrode_Material ;
                 :epistemicStatus "inferred" ;
                 rdfs:comment "Derived. rdfs:subPropertyOf hasElectrode." ;
                 rdfs:label "hasTopElectrode" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#measuredOn
:measuredOn rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Measurement ;
            rdfs:range :Artifact ;
            :epistemicStatus "verified" ;
            :sourceLocator "S12a{P5}" ;
            rdfs:comment "Distinguish blanket film, patterned capacitor, single cell and array. S12a measures both 1C and 1T-1C and reports they agree." ;
            rdfs:label "measuredOn" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#measurementMethod
:measurementMethod rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Measurement ;
                   rdfs:range :Measurement_Method ;
                   :epistemicStatus "scaffolding" ;
                   rdfs:label "measurementMethod" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#measuresProperty
:measuresProperty rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :Measurement ;
                  rdfs:range :Measured_Property ;
                  :epistemicStatus "scaffolding" ;
                  rdfs:label "measuresProperty" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#mitigatedBy
:mitigatedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :Degradation_Phenomenon ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :Material
                                        :Unit_Process
                                      )
                        ] ;
             :epistemicStatus "verified" ;
             :sourceLocator "S24{3.2}, S1{II A 3}" ;
             rdfs:label "mitigatedBy" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#precedes
:precedes rdf:type owl:ObjectProperty ,
                   owl:TransitiveProperty ;
          rdfs:domain :Unit_Process ;
          rdfs:range :Unit_Process ;
          :epistemicStatus "scaffolding" ;
          rdfs:comment "Transitive closure of directlyPrecedes, scoped by flow. Asserted only between steps sharing a belongsToFlow value. NOTE: the specification asked for transitive AND asymmetric AND irreflexive. That combination is illegal in OWL 2 DL: asymmetry and irreflexivity may only be declared on simple properties, and a transitive property is by definition non-simple. HermiT rejects the ontology outright rather than reporting an inconsistency. Transitivity is the useful half, so it is kept. Acyclicity is enforced at generation time and would belong in SHACL, not OWL. directlyPrecedes is simple and keeps both characteristics." ;
          rdfs:label "precedes" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#precludes
:precludes rdf:type owl:ObjectProperty ;
           rdfs:domain :Capability ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :Array_Architecture
                                      :Memory_Cell_Architecture
                                    )
                      ] ;
           :epistemicStatus "verified" ;
           :sourceLocator "S1{II B}" ;
           rdfs:comment "LineOfSight precludes the 3D capacitor. Previously stated only in prose on enables." ;
           rdfs:label "precludes" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#producesMeasurement
:producesMeasurement rdf:type owl:ObjectProperty ;
                     rdfs:domain :Characterisation ;
                     rdfs:range :Measurement ;
                     :epistemicStatus "inferred" ;
                     rdfs:comment "Links the characterisation step to what it produced. A characterisation is a Unit_Process, so it also carries belongsToFlow and its position in the ordering." ;
                     rdfs:label "producesMeasurement" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#requiresCapability
:requiresCapability rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :Array_Architecture
                                                :Unit_Process
                                              )
                                ] ;
                    rdfs:range :Capability ;
                    :epistemicStatus "scaffolding" ;
                    rdfs:label "requiresCapability" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#scavengesOxygenFrom
:scavengesOxygenFrom rdf:type owl:ObjectProperty ;
                     rdfs:domain :Electrode_Material ;
                     rdfs:range :Ferroelectric_Material ;
                     :epistemicStatus "verified" ;
                     :sourceLocator "S1{II A 2}, S24{4}" ;
                     rdfs:comment "TiN and TaN scavenge; IrO2 does not and degrades ferroelectricity; Ru scavenges less than TiN." ;
                     rdfs:label "scavengesOxygenFrom" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#slotMaterial
:slotMaterial rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Layer_Slot ;
              rdfs:range :Material ;
              :epistemicStatus "inferred" ;
              rdfs:comment "One slot holds exactly one material." ;
              rdfs:label "slotMaterial" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#slotRole
:slotRole rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Layer_Slot ;
          rdfs:range :Layer_Role ;
          :epistemicStatus "inferred" ;
          :sourceLocator "S1{II}" ;
          rdfs:comment "The function the material serves here. Pt is an Electrode_Material by class but a contact_pad by role in an MFM coupon and a bottom_electrode by role in a PLD stack." ;
          rdfs:label "slotRole" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#stabilisesPhase
:stabilisesPhase rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :Defect
                                             :Material
                                           )
                             ] ;
                 rdfs:range :Phase_State ;
                 :epistemicStatus "verified" ;
                 :sourceLocator "S1{I A, I B, II A 2}" ;
                 rdfs:label "stabilisesPhase" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#templates
:templates rdf:type owl:ObjectProperty ;
           rdfs:domain :Material ;
           rdfs:range :Material ;
           :epistemicStatus "uncertain" ;
           :sourceLocator "S27{p.1134}" ;
           :uncertaintyRef "U17" ;
           rdfs:comment "t-phase grains sit within 5 degrees of both TiN layers, suggesting near-epitaxial growth during PMA. S27 says 'may be some kind of': implied, not demonstrated." ;
           rdfs:label "templates" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#transformsPhase
:transformsPhase rdf:type owl:ObjectProperty ;
                 rdfs:domain :Unit_Process ;
                 rdfs:range :Phase_State ;
                 :epistemicStatus "verified" ;
                 :sourceLocator "S24{2}" ;
                 rdfs:comment "Domain is Unit_Process, not Thermal_Process. In Flow E an ALD electrode deposition performs the transformation." ;
                 rdfs:label "transformsPhase" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#usesEquipment
:usesEquipment rdf:type owl:ObjectProperty ;
               rdfs:domain :Unit_Process ;
               rdfs:range :Equipment ;
               :epistemicStatus "verified" ;
               :sourceLocator "S24{2}" ;
               rdfs:comment "Many-to-many. One ALD reactor serves electrode and ferroelectric deposition in S24." ;
               rdfs:label "usesEquipment" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#usesOxidant
:usesOxidant rdf:type owl:ObjectProperty ;
             rdfs:domain :Deposition ;
             rdfs:range :Oxidant ;
             :epistemicStatus "scaffolding" ;
             rdfs:label "usesOxidant" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#usesPrecursor
:usesPrecursor rdf:type owl:ObjectProperty ;
               rdfs:domain :Deposition ;
               rdfs:range :Chemical_Precursor ;
               :epistemicStatus "scaffolding" ;
               rdfs:label "usesPrecursor" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#usesProcessGas
:usesProcessGas rdf:type owl:ObjectProperty ;
                rdfs:domain :Unit_Process ;
                rdfs:range :Process_Gas ;
                :epistemicStatus "scaffolding" ;
                rdfs:comment "Covers carrier, sputter, anneal ambient and etch gases." ;
                rdfs:label "usesProcessGas" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#usesStack
:usesStack rdf:type owl:ObjectProperty ;
           rdfs:domain :Memory_Cell_Architecture ;
           rdfs:range :Layer_Stack ;
           :epistemicStatus "verified" ;
           :sourceLocator "S5" ;
           rdfs:comment "FeFET_1T uses MFIS; FeMFET_1T1C uses MFMIS." ;
           rdfs:label "usesStack" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#usesStackingStrategy
:usesStackingStrategy rdf:type owl:ObjectProperty ;
                      rdfs:domain :Array_Architecture ;
                      rdfs:range :Stacking_Strategy ;
                      :epistemicStatus "scaffolding" ;
                      rdfs:label "usesStackingStrategy" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#usesTarget
:usesTarget rdf:type owl:ObjectProperty ;
            rdfs:domain :Sputter_Deposition ;
            rdfs:range :Sputter_Target ;
            :epistemicStatus "scaffolding" ;
            rdfs:label "usesTarget" .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#fractionMethod
:fractionMethod rdf:type owl:DatatypeProperty ;
                rdfs:domain :Measurement ;
                rdfs:range [ rdf:type rdfs:Datatype ;
                             owl:oneOf [ rdf:type rdf:List ;
                                         rdf:first "GIXRD_intensity_ratio" ;
                                         rdf:rest [ rdf:type rdf:List ;
                                                    rdf:first "PED_mapping" ;
                                                    rdf:rest [ rdf:type rdf:List ;
                                                               rdf:first "k_value_inference" ;
                                                               rdf:rest rdf:nil
                                                             ]
                                                  ]
                                       ]
                           ] ;
                :epistemicStatus "verified" ;
                :sourceLocator "S24{3.1}, S9{p.3}, S27" ;
                rdfs:comment "Moved from Phase_State. A phase fraction without its method is not interpretable." ;
                rdfs:label "fractionMethod" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasAppliedField_MVcm
:hasAppliedField_MVcm rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Measurement ;
                      rdfs:range xsd:double ;
                      :epistemicStatus "scaffolding" ;
                      rdfs:label "hasAppliedField_MVcm" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasAppliedVoltage_V
:hasAppliedVoltage_V rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Measurement ;
                     rdfs:range xsd:double ;
                     :epistemicStatus "scaffolding" ;
                     rdfs:label "hasAppliedVoltage_V" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasArraySize_bit
:hasArraySize_bit rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Memory_Cell_Architecture ;
                  rdfs:range xsd:int ;
                  :epistemicStatus "verified" ;
                  :sourceLocator "S12a" ;
                  rdfs:label "hasArraySize_bit" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasBakeTime_min
:hasBakeTime_min rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Measurement ;
                 rdfs:range xsd:double ;
                 :epistemicStatus "verified" ;
                 :sourceLocator "S24{3.3}" ;
                 rdfs:label "hasBakeTime_min" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasBandgap_eV
:hasBandgap_eV rdf:type owl:DatatypeProperty ;
               rdfs:domain :Material ;
               rdfs:range xsd:double ;
               :epistemicStatus "verified" ;
               :sourceLocator "S1{I}, S23{1}" ;
