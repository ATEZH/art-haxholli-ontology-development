###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#A3_FE_Deposition
:A3_FE_Deposition rdf:type owl:NamedIndividual ,
                           :Deposition ;
                  :belongsToFlow :FlowA_LabMFM ;
                  :depositsMaterial :HfO2 ;
                  :directlyPrecedes :A4_TE_Capping ;
                  :precedes :A4_TE_Capping ,
                            :A5_Crystallisation_Anneal ,
                            :A6_Patterned_Metal_Deposition ,
                            :A7_SC1_Etch ;
                  :hasStepIndex "3"^^xsd:int ;
                  :epistemicStatus "verified" ;
                  :sourceLocator "S1" ;
                  rdfs:comment "Typed at the parent class Deposition and at no subclass. S1 says the ferroelectric can be deposited by ALD, sputter, PLD or CSD and does not choose. Typing it as ALD would assert something S1 never said." ;
                  rdfs:label "A3_FE_Deposition" .


