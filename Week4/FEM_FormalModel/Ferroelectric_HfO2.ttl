###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#Layer_Role
:Layer_Role rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Class ;
                                  owl:oneOf ( :bottom_electrode
                                              :channel
                                              :contact_pad
                                              :ferroelectric_layer
                                              :gate_metal
                                              :insertion_layer
                                              :interfacial_layer
                                              :internal_electrode
                                              :seed_layer
                                              :substrate
                                              :top_electrode
                                            )
                                ] ;
            :epistemicStatus "inferred" ;
            rdfs:comment "The function a material serves at one position in one stack." ;
            rdfs:label "Layer Role" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#Layer_Slot
:Layer_Slot rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :slotMaterial ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Material
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :slotRole ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Layer_Role
                            ] ;
            :epistemicStatus "inferred" ;
            rdfs:comment "REIFIED. One position in one stack. Carries layerIndex, the material occupying it, the role it plays there, and the as-fabricated thickness. Reified because role and thickness are properties of the position, not of the material: Si is a substrate in Flow A and a channel in Flow B1, and HZO is 9 nm in Flow B1 and 9.5 nm in Flow G." ;
            rdfs:label "Layer Slot" .


