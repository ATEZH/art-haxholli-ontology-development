                                   rdfs:range xsd:double ;
                                   :epistemicStatus "verified" ;
                                   :sourceLocator "S1{I C}" ;
                                   rdfs:label "hasTransformationBarrier_meVperFU" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasUnit
:hasUnit rdf:type owl:DatatypeProperty ;
         rdfs:domain :Measurement ;
         rdfs:range xsd:string ;
         :epistemicStatus "scaffolding" ;
         rdfs:label "hasUnit" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasVthConvention
:hasVthConvention rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Measurement ;
                  rdfs:range [ rdf:type rdfs:Datatype ;
                               owl:oneOf [ rdf:type rdf:List ;
                                           rdf:first "constant_current" ;
                                           rdf:rest [ rdf:type rdf:List ;
                                                      rdf:first "linear_extrapolation" ;
                                                      rdf:rest rdf:nil
                                                    ]
                                         ]
                             ] ;
                  :epistemicStatus "verified" ;
                  :sourceLocator "S10{II A}, S11{II}" ;
                  :uncertaintyRef "U16" ;
                  rdfs:comment "S10 uses linear extrapolation, S11 constant current, on near-identical stacks. Memory windows are not comparable without this field." ;
                  rdfs:label "hasVthConvention" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasWaveform
:hasWaveform rdf:type owl:DatatypeProperty ;
             rdfs:domain :Measurement ;
             rdfs:range [ rdf:type rdfs:Datatype ;
                          owl:oneOf [ rdf:type rdf:List ;
                                      rdf:first "NDPU" ;
                                      rdf:rest [ rdf:type rdf:List ;
                                                 rdf:first "PUND" ;
                                                 rdf:rest [ rdf:type rdf:List ;
                                                            rdf:first "square" ;
                                                            rdf:rest [ rdf:type rdf:List ;
                                                                       rdf:first "trapezoidal" ;
                                                                       rdf:rest [ rdf:type rdf:List ;
                                                                                  rdf:first "triangle" ;
                                                                                  rdf:rest rdf:nil
                                                                                ]
                                                                     ]
                                                          ]
                                               ]
                                    ]
                        ] ;
             :epistemicStatus "scaffolding" ;
             rdfs:label "hasWaveform" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#hasWriteVoltage_V
:hasWriteVoltage_V rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Memory_Cell_Architecture ;
                   rdfs:range xsd:double ;
                   :epistemicStatus "verified" ;
                   :sourceLocator "S11{III}" ;
                   rdfs:label "hasWriteVoltage_V" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#isCrystallising
:isCrystallising rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Unit_Process ;
                 rdfs:range xsd:boolean ;
                 :epistemicStatus "verified" ;
                 :sourceLocator "S24{2}" ;
                 rdfs:comment "True for E5, an ALD deposition that crystallises the film without a separate anneal." ;
                 rdfs:label "isCrystallising" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#isFerroelectric
:isFerroelectric rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Phase_State ;
                 rdfs:range xsd:boolean ;
                 :epistemicStatus "verified" ;
                 :sourceLocator "S1{I A}" ;
                 rdfs:comment "True only for Pca21, and for the contested R3m." ;
                 rdfs:label "isFerroelectric" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#layerIndex
:layerIndex rdf:type owl:DatatypeProperty ;
            rdfs:domain :Layer_Slot ;
            rdfs:range xsd:int ;
            :epistemicStatus "inferred" ;
            rdfs:comment "1 at the bottom, ascending upward." ;
            rdfs:label "layerIndex" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#phasesLumped
:phasesLumped rdf:type owl:DatatypeProperty ;
              rdfs:domain :Measurement ;
              rdfs:range [ rdf:type rdfs:Datatype ;
                           owl:oneOf [ rdf:type rdf:List ;
                                       rdf:first "none" ;
                                       rdf:rest [ rdf:type rdf:List ;
                                                  rdf:first "o+t" ;
                                                  rdf:rest rdf:nil
                                                ]
                                     ]
                         ] ;
              :epistemicStatus "verified" ;
              :sourceLocator "S24{3.1}" ;
              rdfs:comment "Moved from Phase_State. o and t peaks overlap in GI-XRD, so many sources quantify m only and lump o+t." ;
              rdfs:label "phasesLumped" .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#ALD
:ALD rdf:type owl:Class ;
     rdfs:subClassOf :Deposition ;
     :epistemicStatus "verified" ;
     :sourceLocator "S1{II A}" ;
     rdfs:label "ALD" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#Amorphous
:Amorphous rdf:type owl:Class ;
           rdfs:subClassOf :Phase_State ;
           :epistemicStatus "verified" ;
           :sourceLocator "S1{II A 1}" ;
           rdfs:label "Amorphous" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#Array_Architecture
:Array_Architecture rdf:type owl:Class ;
                    :epistemicStatus "verified" ;
                    :sourceLocator "S5" ;
                    rdfs:comment "An arrangement of cells into an addressable array." ;
                    rdfs:label "Array Architecture" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#Array_Level_Degradation
:Array_Level_Degradation rdf:type owl:Class ;
                         rdfs:subClassOf :Degradation_Phenomenon ;
                         owl:disjointWith :Film_Level_Degradation ;
                         :epistemicStatus "inferred" ;
                         rdfs:comment "Attaches to an Array_Architecture. Before this split, exhibits had no domain that could carry Pass_Disturb." ;
                         rdfs:label "Array Level Degradation" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#Array_Specimen
:Array_Specimen rdf:type owl:Class ;
                rdfs:subClassOf :Artifact ;
                :epistemicStatus "verified" ;
                :sourceLocator "S12a" ;
                rdfs:comment "An array measured as a unit. S12a measures a 1C capacitor and a 1T-1C array from the same wafer and reports they agree: two artifacts, one wafer." ;
                rdfs:label "Array Specimen" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#Artifact
:Artifact rdf:type owl:Class ;
          :epistemicStatus "inferred" ;
          rdfs:comment "The physical specimen a Measurement points at. Distinguishing specimen types is what makes two measurements comparable or not." ;
          rdfs:label "Artifact" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#BEOLProcess
:BEOLProcess rdf:type owl:Class ;
             rdfs:subClassOf :Unit_Process ;
             :epistemicStatus "verified" ;
             :sourceLocator "S12a{Fig. 1a}" ;
             rdfs:label "BEOLProcess" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#Bilayer
:Bilayer rdf:type owl:Class ;
         rdfs:subClassOf :Layer_Stack ;
         :epistemicStatus "verified" ;
         :sourceLocator "S1{II A 3}" ;
         rdfs:label "Bilayer" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#Blanket_Film
:Blanket_Film rdf:type owl:Class ;
              rdfs:subClassOf :Artifact ;
              :epistemicStatus "verified" ;
              :sourceLocator "S1, S9, S27" ;
              rdfs:comment "Unpatterned film on a wafer." ;
              rdfs:label "Blanket Film" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#CSD
:CSD rdf:type owl:Class ;
     rdfs:subClassOf :Deposition ;
     :epistemicStatus "verified" ;
     :sourceLocator "S1{II D}" ;
     rdfs:label "CSD" .


###  http://www.semanticweb.org/art/ontologies/2026/8/ferroelectric-hfo2#Capability
:Capability rdf:type owl:Class ;
            :epistemicStatus "verified" ;
            :sourceLocator "S1{II A, II B, III}" ;
